    "base_pins.randomx": "RandomX commit. Must be 7607fb2faed24d5a679e139a9828d194bbc644a4 for this release line.",
    "patch_fingerprint": "sha256 of the concatenated patches/*.patch of the tree the package was built from (cat patches/*.patch | sha256sum). Compare it with doc/verification.md before trusting a build.",
    "files": "sha256 of every file in the package, keyed by forward-slash path relative to the package root, sorted. version.json itself and SHA256SUMS.windows.txt / .asc are excluded: a file cannot contain its own hash, and those files cover or sign the others. The Tor Expert Bundle is identified here by the hashes of tor/tor.exe and the other files copied from it; record the human-readable Tor version in the release notes.",
    "signature": "This directory does not sign anything. SHA256SUMS.windows.txt is signed offline with the release GPG key, producing SHA256SUMS.windows.txt.asc. See windows/README.md and doc/release.md."
