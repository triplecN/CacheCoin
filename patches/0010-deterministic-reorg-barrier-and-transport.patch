+        constexpr size_t PERTICKET_MAX_SIZE{32 + 9 + 512 + 4};
+        if (vRecv.size() > PERTICKET_MAX_SIZE) {
+            Misbehaving(peer, "oversized perticket");
+            return;
+        }
