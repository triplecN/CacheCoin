 /**
- * CacheCoin anti-51% barrier: switching from `reference` (the tip the node had when it
- * started choosing) to `candidate` must not disconnect more than MAX_REORG_DEPTH blocks,
- * unless the candidate branch either
- *  - carries more than twice the work the reference chain gained since the fork, or
- *  - leads the reference chain by REORG_HEAL_LEAD_BLOCKS blocks of work.
- * The second condition bounds how long honest nodes separated by a network partition
- * can stay apart: once one side has out-mined the other by that margin, every node
- * converges on it. Without it a hashrate split below 2:1 would never heal.
- */
+ * CacheCoin anti-51% barrier. A candidate that extends the chain this node is
+ * already on is always followed: nothing is disconnected, so it is ordinary
+ * catch-up and may be any distance behind.
+ *
+ * Otherwise the switch must not disconnect more than MAX_REORG_DEPTH blocks of
+ * this node's chain, unless the competing branch has already run
+ * MAX_REORG_DEPTH + REORG_HEAL_LEAD_BLOCKS blocks past the point where the two
+ * diverged.
+ *
+ * The limit is what this node gives up, so it is measured from this node's own
+ * tip. The release is deliberately not: it is measured from the candidate, so
+ * every node lets the same branch through on the same block. That is what
+ * bounds how long a partition can hold the network apart, and it is why a
+ * release stated in work against a local tip is not good enough: a node that
+ * ran ahead released earlier than one that lagged, and the two disagreed about
+ * which chain was active. */
 static bool ReorgPermitted(const CBlockIndex* reference, const CBlockIndex* candidate)
 {
     if (reference == nullptr) return true;
@@ -3235,9 +3247,23 @@ static bool ReorgPermitted(const CBlockIndex* reference, const CBlockIndex* cand
     if (candidate == nullptr) return false;
     const CBlockIndex* fork{LastCommonAncestor(reference, candidate)};
     if (fork == nullptr) return false;
-    if (reference->nHeight - fork->nHeight <= MAX_REORG_DEPTH) return true;
-    if (candidate->nChainWork - fork->nChainWork > (reference->nChainWork - fork->nChainWork) * 2) return true;
-    return candidate->nChainWork >= reference->nChainWork + GetBlockProof(*reference) * REORG_HEAL_LEAD_BLOCKS;
+    // The candidate builds on this node's own tip, so switching to it disconnects
+    // nothing. This is catch-up, not a re-organization, and it has to keep working
+    // however far behind this node is: measuring the candidate's distance from the
+    // fork instead would report the whole backlog here and refuse everything from
+    // the 6th block onward, leaving a node that was briefly offline unable to
+    // advance at all.
+    if (fork == reference) return true;
+    // A real fork. What the barrier limits is how much of this node's chain the
+    // switch would undo.
+    const int rollback{reference->nHeight - fork->nHeight};
+    if (rollback <= MAX_REORG_DEPTH) return true;
+    // Released only once the competing branch is far enough past the fork that the
+    // refusal can no longer be holding the network apart. Stated against the
+    // candidate so that every node releases on the same block and a split always
+    // converges, rather than each node waiting for a margin measured from a tip
+    // that differs between them.
+    return candidate->nHeight - fork->nHeight > MAX_REORG_DEPTH + REORG_HEAL_LEAD_BLOCKS;
 }
 
