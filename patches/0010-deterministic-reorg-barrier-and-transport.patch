+            constexpr double refill_per_second{4.0}, bucket_max{4.0};
             const auto now{GetTime<std::chrono::microseconds>()};
             if (peer.m_per_ticket_last.count() != 0) {
                 // Clamp: a backward clock slew must not stall the bucket, and a
@@ -5011,7 +5031,19 @@ void PeerManagerImpl::ProcessMessage(Peer& peer, CNode& pfrom, const std::string
                 // Relay-only nodes never template or mine, so nothing else
