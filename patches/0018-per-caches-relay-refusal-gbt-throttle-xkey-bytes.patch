 /** Payout scripts must be spendable and small (no OP_RETURN, no bloat). */
 bool PerPayoutScriptAllowed(const CScript& payout);
 
diff --git a/src/rpc/mining.cpp b/src/rpc/mining.cpp
index 060c1e4..5c8b571 100644
--- a/src/rpc/mining.cpp
+++ b/src/rpc/mining.cpp
@@ -881,9 +881,14 @@ static RPCHelpMan getblocktemplate()
     // trip the cache below. Rebuild when the pool mutates, or relayed tickets
     // stay invisible to getblocktemplate miners until the next block/mempool tick.
     static uint64_t nPerPoolVersionLast{0};
+    static int64_t time_pool{0};
+    // A fresh template is expensive (a full mempool scan and coinbase build), so
+    // the pool term is throttled as well: a peer that relays one cheap ticket per
+    // second would otherwise force every miner to rebuild on every call. Five
+    // seconds of staleness only delays including a just-relayed ticket.
     if (!pindexPrev || pindexPrev->GetBlockHash() != tip ||
         (mempool.GetTransactionsUpdated() != nTransactionsUpdatedLast && GetTime() - time_start > 5) ||
-        PerPoolVersion() != nPerPoolVersionLast)
+        (PerPoolVersion() != nPerPoolVersionLast && GetTime() - time_pool > 5))
     {
         // Clear pindexPrev so future calls make a new block, despite any failures from here on
         pindexPrev = nullptr;
@@ -891,6 +896,7 @@ static RPCHelpMan getblocktemplate()
         // Store the pindexBest used before createNewBlock, to avoid races
         nTransactionsUpdatedLast = mempool.GetTransactionsUpdated();
         nPerPoolVersionLast = PerPoolVersion();
+        time_pool = GetTime();
         CBlockIndex* pindexPrevNew = chainman.m_blockman.LookupBlockIndex(tip);
         time_start = GetTime();
 
diff --git a/src/test/fuzz/per.cpp b/src/test/fuzz/per.cpp
index 0a5d0ed..b9aa218 100644
--- a/src/test/fuzz/per.cpp
+++ b/src/test/fuzz/per.cpp
@@ -152,3 +152,22 @@ FUZZ_TARGET(per_next_state)
         assert(next.tickets == previous.tickets + tickets);
     }
 }
+
+FUZZ_TARGET(per_ticket_script)
+{
+    // Arbitrary script bytes as they could appear in a coinbase: the ticket
+    // parser must never crash or over-read, and anything it accepts must
+    // re-encode through PerTicketOutput to a script that parses back to the
+    // same id and payout (the round trip connect relies on).
+    const std::vector<uint8_t> bytes{buffer.begin(), buffer.end()};
+    const CScript script{bytes.begin(), bytes.end()};
+    const auto ticket{ParsePerTicketScript(script)};
+    if (!ticket) return;
+    const CTxOut out{PerTicketOutput(*ticket)};
+    assert(out.nValue == 0);
+    const auto again{ParsePerTicketScript(out.scriptPubKey)};
+    assert(again.has_value());
+    assert(again->Id() == ticket->Id());
+    assert(again->payout == ticket->payout);
+    (void)PerPayoutScriptAllowed(ticket->payout);
+}
