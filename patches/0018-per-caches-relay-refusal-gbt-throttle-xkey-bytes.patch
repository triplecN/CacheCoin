diff --git a/src/kernel/chainparams.cpp b/src/kernel/chainparams.cpp
index a60e2a4..e532792 100644
--- a/src/kernel/chainparams.cpp
+++ b/src/kernel/chainparams.cpp
@@ -182,8 +182,12 @@ public:
         base58Prefixes[PUBKEY_ADDRESS] = std::vector<unsigned char>(1,28);  // P2PKH start with 'C'
         base58Prefixes[SCRIPT_ADDRESS] = std::vector<unsigned char>(1,88);  // P2SH start with 'c'
         base58Prefixes[SECRET_KEY] =     std::vector<unsigned char>(1,156); // WIF format compatible with keygen.py
+        // Distinct first characters for public and private extended keys ("226..."
+        // and "2EQ..."): with the old secret bytes both started with "226" and were
+        // 112 characters, so an exported xprv could be mistaken for an xpub. No
+        // consensus effect; change only before any mainnet key is exported.
         base58Prefixes[EXT_PUBLIC_KEY] = {0x04, 0xCC, 0x8B, 0x2E};
-        base58Prefixes[EXT_SECRET_KEY] = {0x04, 0xCC, 0xA9, 0x7B};
+        base58Prefixes[EXT_SECRET_KEY] = {0x05, 0xCC, 0xA9, 0x7B};
 
         bech32_hrp = "cccn";
 
diff --git a/src/net_processing.cpp b/src/net_processing.cpp
index 4818a0f..aca7589 100644
--- a/src/net_processing.cpp
+++ b/src/net_processing.cpp
@@ -5046,6 +5046,15 @@ void PeerManagerImpl::ProcessMessage(Peer& peer, CNode& pfrom, const std::string
             // this node already has stays cheap to ignore; the RandomX budget is
             // kept for tickets that are actually new.
             if (PerPoolHas(ticket.Id())) return;
+            // A ticket embedded by one of the last nPerTicketWindow blocks is
+            // inside its replay window and can never be embedded again before the
+            // window passes. Refusing it here stops a peer from re-filling the
+            // pool with the same recently-embedded ids at no cost to itself. The
+            // cache is in memory only, so this stays cheap under cs_main.
+            if (PerEmbeddedRecently(ticket.Id(), m_chainman.ActiveChain().Tip(),
+                                    m_chainman.GetConsensus())) {
+                return;
+            }
             // The bucket lives on the Peer, so a new TCP connection restarts it at
             // the cap, and the initial value has to match the cap or the first
             // message of every connection would be charged the old, larger one.
@@ -5121,6 +5130,9 @@ void PeerManagerImpl::ProcessMessage(Peer& peer, CNode& pfrom, const std::string
             const int diff2{tip->nHeight - anchorIdx->nHeight};
             if (diff2 < 0 || diff2 >= m_chainman.GetConsensus().nPerTicketWindow) return;
             if (PerPoolHas(ticket.Id())) return;
+            // Retest with the fresh tip: the ticket may have been embedded by a
+            // block that connected while our RandomX hash was running.
+            if (PerEmbeddedRecently(ticket.Id(), tip, m_chainman.GetConsensus())) return;
             if (PerPoolAdd(ticket)) RelayPerTicket(ticket);
             return;
         }
diff --git a/src/per.cpp b/src/per.cpp
index cf48a59..4209e21 100644
--- a/src/per.cpp
+++ b/src/per.cpp
@@ -181,6 +181,13 @@ std::mutex g_embedded_mutex;
 std::map<uint256, std::vector<uint256>> g_embedded_cache;
 std::deque<uint256> g_embedded_order;
 
+// One-entry cache for the most recently read block's ticket records. The payout
+// source block is read by the template path and again by the real connect at the
+// same height, and a zero-ticket chain otherwise re-reads its parent for every
+// block. Positive reads only; a failed read is never cached.
+std::mutex g_block_tickets_mutex;
+std::optional<std::pair<uint256, std::vector<PerTicket>>> g_block_tickets_cache;
+
 /** Ticket ids embedded by pindex's block (cached, bounded).
  *
  *  nullopt means the block could not be read. Callers must fail closed (real
@@ -338,10 +345,22 @@ CTxOut PerTicketOutput(const PerTicket& ticket)
     return CTxOut{0, spk};
 }
 
+std::optional<PerTicket> ParsePerTicketScript(const CScript& spk)
+{
+    return ParseTicketFromScript(spk);
+}
+
 std::optional<std::vector<PerTicket>> PerBlockTickets(
     const CBlockIndex* pindex, const node::BlockManager& blockman)
 {
     if (!pindex) return std::nullopt;
+    const uint256 hash{pindex->GetBlockHash()};
+    {
+        std::lock_guard<std::mutex> lock{g_block_tickets_mutex};
+        if (g_block_tickets_cache && g_block_tickets_cache->first == hash) {
+            return g_block_tickets_cache->second;
+        }
+    }
     CBlock block;
     if (!blockman.ReadBlock(block, *pindex)) return std::nullopt;
     if (block.vtx.empty()) return std::nullopt;
@@ -351,12 +370,20 @@ std::optional<std::vector<PerTicket>> PerBlockTickets(
     // become payout rights one epoch later. No commitment (genesis) = no tickets.
     size_t commit_idx{0};
     auto per{ParsePerCommitment(cb, &commit_idx)};
-    if (!per || commit_idx != 1) return std::vector<PerTicket>{};
+    if (!per || commit_idx != 1) {
+        std::lock_guard<std::mutex> lock{g_block_tickets_mutex};
+        g_block_tickets_cache = std::make_pair(hash, std::vector<PerTicket>{});
+        return std::vector<PerTicket>{};
+    }
     std::vector<PerTicket> out;
     const size_t end{std::min<size_t>(2 + per->block_tickets, cb.vout.size())};
     for (size_t i = 2; i < end; ++i) {
         if (auto t{ParseTicketFromScript(cb.vout[i].scriptPubKey)}) out.push_back(*t);
     }
+    {
+        std::lock_guard<std::mutex> lock{g_block_tickets_mutex};
+        g_block_tickets_cache = std::make_pair(hash, out);
+    }
     return out;
 }
 
@@ -772,6 +799,27 @@ bool CheckPerTicketsAndPayouts(const CBlock& block, const PerCommitment& per,
     return true;
 }
 
+bool PerEmbeddedRecently(const uint256& id, const CBlockIndex* tip,
+                         const Consensus::Params& params)
+{
+    // Cache-only on purpose: called from the P2P handler under cs_main, where a
+    // disk read of the last window of blocks per relayed ticket would stall
+    // block connect. A miss is harmless: the ticket is pooled and then rejected
+    // at connect if it is still inside the replay window (pre-fix behavior).
+    if (!tip) return false;
+    std::lock_guard<std::mutex> lock{g_embedded_mutex};
+    const CBlockIndex* a{tip};
+    for (int i = 0; i < params.nPerTicketWindow && a; ++i) {
+        auto it{g_embedded_cache.find(a->GetBlockHash())};
+        if (it != g_embedded_cache.end() &&
+            std::find(it->second.begin(), it->second.end(), id) != it->second.end()) {
+            return true;
+        }
+        a = a->pprev;
+    }
+    return false;
+}
+
 void PerPoolDropEmbedded(const CBlock& block, const PerCommitment& per,
                          const CBlockIndex* pindex,
                          const node::BlockManager& blockman)
@@ -780,7 +828,14 @@ void PerPoolDropEmbedded(const CBlock& block, const PerCommitment& per,
     // has passed. Dropping tickets inside CheckPerTicketsAndPayouts would let a
     // rejected block (wrong state, overpaying coinbase) remove tickets this node
     // still holds and would never embed again.
-    if (!pindex || per.block_tickets == 0 || block.vtx.empty()) return;
+    if (!pindex || block.vtx.empty()) return;
+    if (per.block_tickets == 0) {
+        // Cache the empty answer too: a zero-ticket chain would otherwise read its
+        // parent block again for every block of the replay window (~2 block opens
+        // per height on a quiet chain).
+        CacheEmbeddedTicketIds(pindex, {});
+        return;
+    }
     const CTransaction& cb{*block.vtx[0]};
     std::vector<uint256> ids;
     ids.reserve(per.block_tickets);
