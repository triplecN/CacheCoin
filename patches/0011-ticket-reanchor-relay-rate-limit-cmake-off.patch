--- a/src/rpc/mining.cpp
+++ b/src/rpc/mining.cpp
@@ -1234,10 +1234,13 @@ static RPCHelpMan generateperticket()
     return RPCHelpMan{"generateperticket",
         "Mine one PER entropy ticket for the given payout address, anchored to the current tip,\n"
         "and add it to this node's pool so the next block can embed it. For CPU miners who want a\n"
-        "share of the epoch reservoir without having to find a full block.\n",
+        "share of the epoch reservoir without having to find a full block. The search re-anchors\n"
+        "to the current tip every 1024 nonces, so a ticket found after a long search is still\n"
+        "valid. A large maxtries can hold this RPC thread for hours; a bounded value in a shell\n"
+        "loop is usually better (see deploy/README.md).\n",
         {
             {"address", RPCArg::Type::STR, RPCArg::Optional::NO, "The CacheCoin address the ticket pays to"},
-            {"maxtries", RPCArg::Type::NUM, RPCArg::Default{1000000}, "How many nonces to try"},
+            {"maxtries", RPCArg::Type::NUM, RPCArg::Default{1000000}, "How many nonces to try. The search re-anchors to the current tip every 1024 nonces, so a ticket found after a long search is still anchored to a recent block"},
         },
         RPCResult{RPCResult::Type::OBJ, "", "", {
             {RPCResult::Type::BOOL, "found", "whether a ticket was found within maxtries"},
@@ -1256,19 +1259,34 @@ static RPCHelpMan generateperticket()
     uint64_t tries = request.params[1].isNull() ? 1000000 : request.params[1].getInt<uint64_t>();
 
     ChainstateManager& chainman = EnsureAnyChainman(request.context);
-    uint256 anchor;
-    uint32_t anchor_nbits;
     const Consensus::Params& consensus = chainman.GetConsensus();
-    {
-        LOCK(cs_main);
-        const CBlockIndex* tip = chainman.ActiveChain().Tip();
-        // No tip yet (start-up before genesis load): refuse instead of dereferencing null.
-        if (!tip) throw JSONRPCError(RPC_CLIENT_IN_INITIAL_DOWNLOAD, "Node has no tip yet");
-        anchor = tip->GetBlockHash();
-        anchor_nbits = tip->nBits;
+    // Mine in slices, each anchored to the tip at the time the slice starts. A ticket
+    // is only valid while its anchor is within nPerTicketWindow blocks, so searching
+    // one fixed anchor for longer than that window would find a ticket that is already
+    // stale, and the validation below would throw it away. Re-anchoring keeps the
+    // ticket fresh when it is found; the expected work is unchanged, because the
+    // ticket target does not depend on how long a single anchor has been searched.
+    std::optional<PerTicket> ticket;
+    uint64_t remaining{tries};
+    // 1024 light-mode hashes is about 20 s on a normal CPU and about 2.5 minutes in
+    // the interpreter, both far inside the 10-block (~10 minute) anchor window.
+    constexpr uint64_t PER_ANCHOR_SLICE{1024};
+    while (remaining > 0 && !ticket && !static_cast<bool>(chainman.m_interrupt)) {
+        uint256 anchor;
+        uint32_t anchor_nbits;
+        {
+            LOCK(cs_main);
+            const CBlockIndex* tip = chainman.ActiveChain().Tip();
+            // No tip yet (start-up before genesis load): refuse instead of dereferencing null.
+            if (!tip) throw JSONRPCError(RPC_CLIENT_IN_INITIAL_DOWNLOAD, "Node has no tip yet");
+            anchor = tip->GetBlockHash();
+            anchor_nbits = tip->nBits;
+        }
+        // v31.1 port: chainman.m_interrupt replaces the removed global ShutdownRequested().
+        const uint64_t slice{std::min(remaining, PER_ANCHOR_SLICE)};
+        ticket = PerMineTicket(anchor, anchor_nbits, payout, slice, consensus, &chainman.m_interrupt);
+        remaining -= slice;
     }
-    // v31.1 port: chainman.m_interrupt replaces the removed global ShutdownRequested().
-    const auto ticket = PerMineTicket(anchor, anchor_nbits, payout, tries, consensus, &chainman.m_interrupt);
 
     UniValue result(UniValue::VOBJ);
     result.pushKV("found", (bool)ticket);
