 src/kernel/CMakeLists.txt | 13 ++++++------
 src/net_processing.cpp    |  9 +++++++-
 src/node/types.h          | 13 +++++++-----
 src/per.cpp               | 29 +++++++++++++++++++++-----
 src/rpc/mining.cpp        | 44 +++++++++++++++++++++++++++------------
 6 files changed, 84 insertions(+), 38 deletions(-)

