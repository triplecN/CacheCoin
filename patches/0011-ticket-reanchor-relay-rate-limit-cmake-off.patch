diff --git a/src/per.cpp b/src/per.cpp
index 3b2068b..e653d96 100644
--- a/src/per.cpp
+++ b/src/per.cpp
@@ -180,8 +180,20 @@ std::mutex g_embedded_mutex;
 std::map<uint256, std::vector<uint256>> g_embedded_cache;
 std::deque<uint256> g_embedded_order;
 
-/** Ticket ids embedded by pindex's block (cached, bounded). nullopt means
- *  the block could not be read (callers treat that as retryable, not empty). */
+/** Ticket ids embedded by pindex's block (cached, bounded).
+ *
+ *  Deliberate limitation, recorded so it is not "fixed" into a worse state: when
+ *  the block cannot be read, PerBlockTickets returns nullopt but this function
+ *  returns an EMPTY set (and caches that answer). The callers' "retryable on
+ *  nullopt" guards therefore never fire on a read failure. Propagating the nullopt
+ *  was tried and breaks template building, because a read returning nothing is
+ *  normal on the path the miner takes; that is why the behaviour stays. The
+ *  consequence is recorded in SECURITY.md ("Known accepted risks"): a read failure
+ *  disables cross-block replay detection for that window, so a replayed ticket can
+ *  be embedded twice and paid twice from the same reservoir (no inflation, but the
+ *  other ticket holders get less), and a node that hits the failure can accept a
+ *  block other nodes reject. Fixing this needs the mining path to tolerate the
+ *  nullopt first; do not flip the return value on its own. */
 std::optional<std::set<uint256>> EmbeddedTicketIds(const CBlockIndex* pindex,
                                                     const node::BlockManager& blockman)
 {
@@ -194,10 +206,16 @@ std::optional<std::set<uint256>> EmbeddedTicketIds(const CBlockIndex* pindex,
         }
     }
     std::set<uint256> ids;
+    bool readable{false};
     if (auto t{PerBlockTickets(pindex, blockman)}) {
+        readable = true;
         for (const auto& x : *t) ids.insert(x.Id());
     }
-    {
+    // Only cache successful reads. A failed read still answers "no tickets" for this
+    // call (see the comment above), but caching that answer would keep the blind
+    // window open until the entry is evicted. Leaving it uncached makes the next
+    // caller retry the disk read, so a transient fault heals by itself.
+    if (readable) {
         std::lock_guard<std::mutex> lock{g_embedded_mutex};
         g_embedded_cache[hash] = std::vector<uint256>(ids.begin(), ids.end());
         g_embedded_order.push_back(hash);
@@ -613,8 +631,9 @@ bool CheckPerTicketsAndPayouts(const CBlock& block, const PerCommitment& per,
         const CBlockIndex* a{parent};
         for (int i = 0; i < params.nPerTicketWindow && a; ++i) {
             auto hist{EmbeddedTicketIds(a, blockman)};
-            // Unreadable history must not silently disable replay detection
-            // (a replay could then over-mint): retryable, like the paths above.
+            // EmbeddedTicketIds returns an empty set, not nullopt, when the block
+            // cannot be read (see its comment). Keep this guard for an eventual
+            // implementation that distinguishes the two; today it is unreachable.
             if (!hist) return state.Error("cannot read ticket history");
             seen.insert(hist->begin(), hist->end());
             a = a->pprev;
