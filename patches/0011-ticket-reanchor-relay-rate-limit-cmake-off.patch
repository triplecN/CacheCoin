diff --git a/src/net_processing.cpp b/src/net_processing.cpp
index 24a0289..4587ba1 100644
--- a/src/net_processing.cpp
+++ b/src/net_processing.cpp
@@ -5006,6 +5006,14 @@ void PeerManagerImpl::ProcessMessage(Peer& peer, CNode& pfrom, const std::string
         uint32_t anchor_nbits{0};
         {
             LOCK(cs_main);
+            // A ticket this node already holds is not hashed again, so it must not
+            // spend rate-limit tokens either. Every peer relays each new ticket to
+            // all of its peers, including the one it came from, so counting those
+            // echoes as a flood would disconnect honest peers during a ticket burst.
+            // The check costs one hash and a map lookup, so a peer that spams ids
+            // this node already has stays cheap to ignore; the RandomX budget is
+            // kept for tickets that are actually new.
+            if (PerPoolHas(ticket.Id())) return;
             // The bucket lives on the Peer, so a new TCP connection restarts it at
             // the cap, and the initial value has to match the cap or the first
             // message of every connection would be charged the old, larger one.
@@ -5049,7 +5057,6 @@ void PeerManagerImpl::ProcessMessage(Peer& peer, CNode& pfrom, const std::string
                     return;
                 }
             }
-            if (PerPoolHas(ticket.Id())) return; // already have it; do not re-verify or loop
             const CBlockIndex* tip{m_chainman.ActiveChain().Tip()};
             if (!tip) return;
             const CBlockIndex* anchorIdx{m_chainman.m_blockman.LookupBlockIndex(ticket.anchor)};
