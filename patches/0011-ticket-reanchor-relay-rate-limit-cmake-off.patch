+# CacheCoin: crypto/randomx_wrapper.cpp (above) is the RandomX proof-of-work, which is
+# consensus-critical and is compiled in both CACHECOIN_RANDOMX configurations (the option
+# only selects where the library comes from). PUBLIC rather than PRIVATE because
+# bitcoin_crypto is a static library: librandomx.a must reach the link line of every
+# consumer, and so must the randomx include directory. Linking it unconditionally is what
+# makes -DCACHECOIN_RANDOMX=OFF (system-installed RandomX) build at all.
+target_link_libraries(bitcoin_crypto PUBLIC randomx)
 
 if(HAVE_SSE41)
   target_compile_definitions(bitcoin_crypto PRIVATE ENABLE_SSE41)
