+/**
+ * CacheCoin: report in getblockchaininfo that the re-org barrier is currently refusing a
+ * competing chain that has more work, or clear that report when it is not.
+ */
+static void SetReorgRefusedWarning(ChainstateManager& chainman, bool flag)
+{
+    if (flag) {
+        chainman.GetNotifications().warningSet(
+            kernel::Warning::REORG_DEPTH_REFUSED,
+            strprintf(_("Warning: the re-org barrier is refusing a competing chain with more work (see getchaintips). "
+                        "The network may be split; this node switches once that chain leads by %d blocks of work."),
+                      REORG_HEAL_LEAD_BLOCKS));
+    } else {
+        chainman.GetNotifications().warningUnset(kernel::Warning::REORG_DEPTH_REFUSED);
+    }
+}
+
+/**
+ * CacheCoin anti-51% barrier: switching from `reference` (the tip the node had when it
+ * started choosing) to `candidate` must not disconnect more than MAX_REORG_DEPTH blocks,
+ * unless the candidate branch either
+ *  - carries more than twice the work the reference chain gained since the fork, or
+ *  - leads the reference chain by REORG_HEAL_LEAD_BLOCKS blocks of work.
+ * The second condition bounds how long honest nodes separated by a network partition
+ * can stay apart: once one side has out-mined the other by that margin, every node
+ * converges on it. Without it a hashrate split below 2:1 would never heal.
+ */
+static bool ReorgPermitted(const CBlockIndex* reference, const CBlockIndex* candidate)
+{
+    if (reference == nullptr) return true;
+    // Defensive, unreachable from FindMostWorkChain (candidates are never null
+    // and every index links back to genesis): a null here fails closed.
+    if (candidate == nullptr) return false;
+    const CBlockIndex* fork{LastCommonAncestor(reference, candidate)};
+    if (fork == nullptr) return false;
+    if (reference->nHeight - fork->nHeight <= MAX_REORG_DEPTH) return true;
+    if (candidate->nChainWork - fork->nChainWork > (reference->nChainWork - fork->nChainWork) * 2) return true;
+    return candidate->nChainWork >= reference->nChainWork + GetBlockProof(*reference) * REORG_HEAL_LEAD_BLOCKS;
+}
+
 /**
