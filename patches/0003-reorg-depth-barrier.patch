+        bool candidates_changed = false;
+        const CBlockIndex* best_refused{nullptr};
+        static const CBlockIndex* last_logged{nullptr};
+        // Candidates from most to least work. A candidate refused by the re-org barrier is
+        // skipped but stays in setBlockIndexCandidates (every valid block with at least the
