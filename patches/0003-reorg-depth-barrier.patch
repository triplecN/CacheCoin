+                bool fFailedChain = pindexTest->nStatus & BLOCK_FAILED_VALID;
+                bool fMissingData = !(pindexTest->nStatus & BLOCK_HAVE_DATA);
+                if (fFailedChain || fMissingData) {
+                    // Candidate chain is not usable (either invalid or missing data)
+                    if (fFailedChain && (m_chainman.m_best_invalid == nullptr || pindexNew->nChainWork > m_chainman.m_best_invalid->nChainWork)) {
+                        m_chainman.m_best_invalid = pindexNew;
+                    }
+                    CBlockIndex *pindexFailed = pindexNew;
+                    // Remove the entire chain from the set.
+                    while (pindexTest != pindexFailed) {
+                        if (fFailedChain) {
+                            pindexFailed->nStatus |= BLOCK_FAILED_VALID;
+                            m_blockman.m_dirty_blockindex.insert(pindexFailed);
+                        } else if (fMissingData) {
+                            // If we're missing data, then add back to m_blocks_unlinked,
+                            // so that if the block arrives in the future we can try adding
+                            // to setBlockIndexCandidates again.
+                            m_blockman.m_blocks_unlinked.insert(
+                                std::make_pair(pindexFailed->pprev, pindexFailed));
+                        }
+                        setBlockIndexCandidates.erase(pindexFailed);
+                        pindexFailed = pindexFailed->pprev;
                     }
-                    setBlockIndexCandidates.erase(pindexFailed);
-                    pindexFailed = pindexFailed->pprev;
+                    setBlockIndexCandidates.erase(pindexTest);
+                    fInvalidAncestor = true;
+                    break;
                 }
-                setBlockIndexCandidates.erase(pindexTest);
-                fInvalidAncestor = true;
+                pindexTest = pindexTest->pprev;
+            }
+            if (fInvalidAncestor) {
+                // The candidate set was modified; start again from the best remaining candidate.
+                candidates_changed = true;
                 break;
             }
-            pindexTest = pindexTest->pprev;
-        }
-        if (!fInvalidAncestor)
+            if (!ReorgPermitted(reorg_reference, pindexNew)) {
+                if (best_refused == nullptr) best_refused = pindexNew;
+                continue;
+            }
+            // Report the refusal once per best refused candidate (at most one line per block
+            // mined on the competing branch), and keep the getblockchaininfo warning current.
+            if (best_refused != nullptr && best_refused != last_logged) {
+                last_logged = best_refused;
+                const CBlockIndex* fork{LastCommonAncestor(reorg_reference, best_refused)};
+                LogInfo("CacheCoin: refused re-org of %d blocks (max %d unless the other branch has more than 2x the work since the fork, "
+                        "or leads by %d blocks of work). Tip: %d, Fork: %d, Candidate: %d %s\n",
+                          reorg_reference->nHeight - fork->nHeight, MAX_REORG_DEPTH, REORG_HEAL_LEAD_BLOCKS,
+                          reorg_reference->nHeight, fork->nHeight, best_refused->nHeight, best_refused->GetBlockHash().ToString());
+            }
+            SetReorgRefusedWarning(m_chainman, best_refused != nullptr);
             return pindexNew;
-    } while(true);
+        }
+        // No usable candidate this pass. When the set did not change we return nullptr, but
