+        // getblockchaininfo warning goes stale when only refused chains remain.
+        if (best_refused != nullptr && best_refused != last_logged) {
+            last_logged = best_refused;
+            const CBlockIndex* fork{LastCommonAncestor(reorg_reference, best_refused)};
+            LogInfo("CacheCoin: refused re-org of %d blocks (max %d unless the other branch has more than 2x the work since the fork, "
+                    "or leads by %d blocks of work). Tip: %d, Fork: %d, Candidate: %d %s\n",
+                      reorg_reference->nHeight - fork->nHeight, MAX_REORG_DEPTH, REORG_HEAL_LEAD_BLOCKS,
+                      reorg_reference->nHeight, fork->nHeight, best_refused->nHeight, best_refused->GetBlockHash().ToString());
+        }
+        SetReorgRefusedWarning(m_chainman, best_refused != nullptr);
+        if (!candidates_changed) return nullptr;
+    } while (true);
 }
 
