+namespace {
+
+using Deadline = std::chrono::steady_clock::time_point;
+
+/** One Bitcoin P2P (v1) message: magic, 12-byte command, length, checksum, payload. */
+std::string Frame(const MessageStartChars& magic, const std::string& command, const std::vector<unsigned char>& payload)
+{
+    std::string out(magic.begin(), magic.end());
+    std::string cmd{command};
+    cmd.resize(CMessageHeader::MESSAGE_TYPE_SIZE, '\0');
+    out += cmd;
+    const uint32_t len = payload.size();
+    for (int i = 0; i < 4; ++i) out.push_back(static_cast<char>((len >> (8 * i)) & 0xff));
+    const uint256 checksum{Hash(payload)};
+    out.append(reinterpret_cast<const char*>(checksum.begin()), CMessageHeader::CHECKSUM_SIZE);
+    out.append(payload.begin(), payload.end());
+    return out;
+}
+
+void RecvExact(const Sock& sock, unsigned char* buf, size_t len, Deadline deadline)
+{
+    size_t got{0};
+    while (got < len) {
+        const auto now{std::chrono::steady_clock::now()};
+        if (now >= deadline) throw std::runtime_error("timeout");
+        Sock::Event occurred;
+        const auto wait{std::min<std::chrono::milliseconds>(std::chrono::duration_cast<std::chrono::milliseconds>(deadline - now), std::chrono::milliseconds{1000})};
+        if (!sock.Wait(wait, Sock::RECV, &occurred)) throw std::runtime_error("socket wait failed");
+        if (!(occurred & Sock::RECV)) continue;
+        const ssize_t n{sock.Recv(buf + got, len - got, 0)};
+        if (n == 0) throw std::runtime_error("connection closed by peer");
+        if (n < 0) {
+            const int err{WSAGetLastError()};
+            if (err == WSAEWOULDBLOCK || err == WSAEINTR) continue;
+            throw std::runtime_error("recv failed: " + NetworkErrorString(err));
+        }
+        got += n;
+    }
+}
+
+/** Read the next message; returns its command and payload. */
+std::pair<std::string, std::vector<unsigned char>> RecvMessage(const Sock& sock, const MessageStartChars& magic, Deadline deadline)
+{
+    unsigned char header[CMessageHeader::HEADER_SIZE];
+    RecvExact(sock, header, sizeof(header), deadline);
+    if (!std::equal(magic.begin(), magic.end(), header)) throw std::runtime_error("wrong network magic");
+    const char* cmd_begin{reinterpret_cast<const char*>(header + magic.size())};
+    const std::string command(cmd_begin, strnlen(cmd_begin, CMessageHeader::MESSAGE_TYPE_SIZE));
+    uint32_t len{0};
+    for (int i = 0; i < 4; ++i) len |= uint32_t{header[CMessageHeader::MESSAGE_SIZE_OFFSET + i]} << (8 * i);
+    if (len > MAX_PROTOCOL_MESSAGE_LENGTH) throw std::runtime_error("oversized message");
+    std::vector<unsigned char> payload(len);
+    if (len > 0) RecvExact(sock, payload.data(), len, deadline);
+    // Verify the checksum like core does: corrupted data must not reach the
+    // deserializers below (invalid input would waste time parsing it).
+    const uint256 msg_checksum{Hash(payload)};
+    if (!std::equal(msg_checksum.begin(), msg_checksum.begin() + CMessageHeader::CHECKSUM_SIZE,
+                    header + CMessageHeader::CHECKSUM_OFFSET)) {
+        throw std::runtime_error("bad message checksum");
+    }
+    return {command, payload};
+}
+
+template <typename T>
+void PutLE(std::vector<unsigned char>& out, T value)
+{
+    for (size_t i = 0; i < sizeof(T); ++i) out.push_back(static_cast<unsigned char>((static_cast<uint64_t>(value) >> (8 * i)) & 0xff));
+}
+
+/** A version message that says as little as possible: no services, no addresses, no
+ *  clock, the same user agent as every other node, no transaction relay to us,
+ *  and start_height always 0. The caller never passes the real tip height, so the
+ *  handshake reveals no tip-height, clock, or address information. */
+std::vector<unsigned char> VersionPayload(int start_height)
+{
+    std::vector<unsigned char> p;
+    PutLE<int32_t>(p, PROTOCOL_VERSION);
+    PutLE<uint64_t>(p, 0);                  // services
+    PutLE<int64_t>(p, 0);                   // time
+    for (int i = 0; i < 2; ++i) p.insert(p.end(), 26, 0); // addr_recv, addr_from (services, IPv6, port)
+    PutLE<uint64_t>(p, FastRandomContext().rand64()); // nonce
+    const std::string& ua{strSubVersion};
+    p.push_back(static_cast<unsigned char>(std::min<size_t>(ua.size(), 252)));
+    p.insert(p.end(), ua.begin(), ua.begin() + std::min<size_t>(ua.size(), 252));
+    PutLE<int32_t>(p, start_height);
+    p.push_back(0);                         // relay: false
+    return p;
+}
+
+void DeliverOne(const CTransaction& tx, const CService& target, const MessageStartChars& magic, int start_height, Deadline deadline)
+{
+    std::unique_ptr<Sock> sock;
+    Proxy proxy;
+    if (GetProxy(target.GetNetwork(), proxy)) {
+        // Isolated-stream SOCKS5 credentials: a fresh circuit per connection *if*
+        // the proxy isolates streams by auth (Tor does with IsolateSOCKSAuth).
+        // With a generic SOCKS proxy the streams may share a circuit.
+        const Proxy isolated{proxy.proxy, /*tor_stream_isolation=*/true};
+        bool proxy_failed{false};
+        sock = ConnectThroughProxy(isolated, target.ToStringAddr(), target.GetPort(), proxy_failed);
+        if (!sock) throw std::runtime_error(proxy_failed ? "proxy (Tor) not reachable" : "could not connect through the proxy");
+    } else {
+        if (target.IsPrivacyNet()) throw std::runtime_error("no proxy configured for this network");
+        sock = ConnectDirectly(target, /*manual_connection=*/true);
+        if (!sock) throw std::runtime_error("could not connect");
+    }
+
+    CThreadInterrupt interrupt;
+    const auto send = [&](const std::string& command, const std::vector<unsigned char>& payload) {
+        const auto left{std::chrono::duration_cast<std::chrono::milliseconds>(deadline - std::chrono::steady_clock::now())};
+        if (left.count() <= 0) throw std::runtime_error("timeout");
+        sock->SendComplete(Frame(magic, command, payload), left, interrupt);
+    };
+
+    send(NetMsgType::VERSION, VersionPayload(start_height));
+    bool got_version{false}, got_verack{false};
+    while (!got_version || !got_verack) {
+        const auto [command, payload]{RecvMessage(*sock, magic, deadline)};
+        if (command == NetMsgType::VERSION && !got_version) {
+            got_version = true;
+            send(NetMsgType::VERACK, {});
+        } else if (command == NetMsgType::VERACK) {
+            got_verack = true;
+        }
+    }
+
+    DataStream ss;
+    ss << TX_WITH_WITNESS(tx);
+    const std::vector<unsigned char> tx_bytes{UCharCast(ss.data()), UCharCast(ss.data() + ss.size())};
+    send(NetMsgType::TX, tx_bytes);
+
+    // Messages are processed in order: the pong proves the transaction was processed.
+    std::vector<unsigned char> ping;
+    PutLE<uint64_t>(ping, FastRandomContext().rand64());
+    send(NetMsgType::PING, ping);
+    while (true) {
+        const auto [command, payload]{RecvMessage(*sock, magic, deadline)};
+        if (command == NetMsgType::PONG && payload == ping) return;
+        if (command == NetMsgType::PING) send(NetMsgType::PONG, payload);
+    }
+}
+
+} // namespace
+
+bool ShunkoTargetIsPrivate(const CService& target)
+{
+    Proxy proxy;
+    return GetProxy(target.GetNetwork(), proxy);
+}
+
+std::vector<ShunkoDelivery> ShunkoDeliver(const CTransaction& tx, const std::vector<CService>& targets,
+                                         const CChainParams& params, int start_height,
+                                         std::chrono::seconds timeout)
+{
+    std::vector<ShunkoDelivery> results;
+    for (const CService& target : targets) {
+        ShunkoDelivery r;
+        r.target = target.ToStringAddrPort();
+        try {
+            DeliverOne(tx, target, params.MessageStart(), start_height, std::chrono::steady_clock::now() + timeout);
+            r.delivered = true;
+        } catch (const std::exception& e) {
+            r.error = e.what();
+        }
+        results.push_back(r);
+    }
+    const auto delivered{std::count_if(results.begin(), results.end(), [](const auto& r) { return r.delivered; })};
+    LogDebug(BCLog::NET, "Shunko: transaction handed to %d of %d nodes over one-shot connections\n", delivered, results.size());
+    return results;
+}
