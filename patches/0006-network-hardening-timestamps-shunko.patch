+#ifndef BITCOIN_SHUNKO_H
+#define BITCOIN_SHUNKO_H
+
+#include <netaddress.h>
+#include <primitives/transaction.h>
+
+#include <chrono>
+#include <string>
+#include <vector>
+
+class CChainParams;
+
+/**
+ * Shunko Protocol (transport layer only; consensus and the public ledger are unchanged).
+ *
+ * A transaction created by this node is never announced by this node. Instead it is
+ * handed to a few other nodes over short-lived connections of their own: each one is a
+ * fresh Tor circuit (SOCKS5 with random credentials, so Tor isolates the stream), does a
+ * plain version/verack handshake, sends the transaction, waits for a pong so it knows the
+ * transaction was processed, and disconnects. Those nodes then relay the transaction as
+ * if it were theirs. This makes it harder to link the transaction to this node's
+ * long-lived connections; receivers see only a Tor client, but timing, amounts
+ * and address reuse can still correlate activity.
+ */
+struct ShunkoDelivery {
+    std::string target;
+    bool delivered{false};
+    std::string error;
+};
+
+/** Hand `tx` to each target over its own one-shot connection (through the configured
+ *  proxy for that network, if any). Blocks until every attempt finished or timed out. */
+std::vector<ShunkoDelivery> ShunkoDeliver(const CTransaction& tx, const std::vector<CService>& targets,
+                                         const CChainParams& params, int start_height,
+                                         std::chrono::seconds timeout);
+
+/** Whether a one-shot connection to `target` would go through a proxy (Tor), i.e. would not
+ *  reveal this node's IP address to the receiving node. */
+bool ShunkoTargetIsPrivate(const CService& target);
+
+#endif // BITCOIN_SHUNKO_H
