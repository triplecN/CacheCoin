+static RPCHelpMan shunkobroadcast()
+{
+    return RPCHelpMan{"shunkobroadcast",
+        "Shunko Protocol: send a signed raw transaction without this node ever announcing it.\n"
+        "The transaction is checked against the mempool rules but NOT added to this node's mempool.\n"
+        "It is handed to a few other nodes over one-shot P2P v1 connections (BIP324 v2 is used for regular peering, not for these hand-overs), each through its own fresh\n"
+        "Tor circuit, and those nodes relay it as usual. The transaction and the public ledger stay\n"
+        "ordinary and auditable; only the link between the transaction and this node (and its IP\n"
+        "address) is hidden. Outside regtest every connection must go through a proxy (Tor).\n"
+        "A call can hold its RPC thread up to about a minute (two rounds of 30 s hand-overs);\n"
+        "do not run more of them concurrently than you have RPC threads.\n"
+        "\"Delivered\" means a peer processed the hand-over connection, not a mempool\n"
+        "acceptance: a peer can still drop the transaction under its own policy, and it\n"
+        "will then never confirm (see scripts/sendtoshunko.sh).\n"
+        "Set walletbroadcast=0 (see deploy/home/cachecoin.conf) and build the transaction\n"
+        "with add_to_wallet=false, otherwise the wallet may announce or rebroadcast it and\n"
+        "reveal this node as its origin. Use a new receiving address for every payment, or the ledger itself links your payments.\n",
+        {
+            {"hexstring", RPCArg::Type::STR_HEX, RPCArg::Optional::NO, "The hex string of the signed raw transaction"},
+            {"peers", RPCArg::Type::NUM, RPCArg::Default{2}, "How many nodes should receive it (1-8)"},
+            {"targets", RPCArg::Type::ARR, RPCArg::Optional::OMITTED, "Nodes to use instead of random known addresses",
+                {
+                    {"address", RPCArg::Type::STR, RPCArg::Optional::OMITTED, "host:port, for example an .onion address"},
+                },
+            },
+            {"maxfeerate", RPCArg::Type::AMOUNT, RPCArg::Default{FormatMoney(DEFAULT_MAX_RAW_TX_FEE_RATE.GetFeePerK())},
+             "Reject transactions whose fee rate is higher than the specified value, expressed in " + CURRENCY_UNIT +
+                 "/kvB.\nSet to 0 to accept any fee rate."},
+        },
+        RPCResult{
+            RPCResult::Type::OBJ, "", "",
+            {
+                {RPCResult::Type::STR_HEX, "txid", "The transaction id"},
+                {RPCResult::Type::NUM, "delivered", "How many hand-overs completed (a peer processed the connection; not a mempool acceptance)"},
+                {RPCResult::Type::ARR, "attempts", "One entry per node tried",
+                    {
+                        {RPCResult::Type::OBJ, "", "",
+                            {
+                                {RPCResult::Type::STR, "target", "host:port"},
+                                {RPCResult::Type::BOOL, "delivered", "Whether the hand-over to the node completed"},
+                                {RPCResult::Type::STR, "error", /*optional=*/true, "Why the delivery failed"},
+                            }},
+                    }},
+            }},
+        RPCExamples{
+            "\nCreate and sign a transaction without broadcasting it, then send it through Shunko\n"
+            + HelpExampleCli("-named send", "outputs='{\"cccn1q...\": 1.5}' add_to_wallet=false lock_unspents=true") +
+            HelpExampleCli("shunkobroadcast", "\"signedhex\"") +
+            HelpExampleRpc("shunkobroadcast", "\"signedhex\"")
+        },
+        [&](const RPCHelpMan& self, const JSONRPCRequest& request) -> UniValue
+        {
+            CMutableTransaction mtx;
+            if (!DecodeHexTx(mtx, request.params[0].get_str())) {
+                throw JSONRPCError(RPC_DESERIALIZATION_ERROR, "TX decode failed. Make sure the tx has at least one input.");
+            }
+            for (const auto& out : mtx.vout) {
+                if ((out.scriptPubKey.IsUnspendable() || !out.scriptPubKey.HasValidOps()) && out.nValue > 0) {
+                    throw JSONRPCTransactionError(TransactionError::MAX_BURN_EXCEEDED);
+                }
+            }
+            const CTransactionRef tx{MakeTransactionRef(std::move(mtx))};
+            const int peers{request.params[1].isNull() ? 2 : request.params[1].getInt<int>()};
+            if (peers < 1 || peers > 8) throw JSONRPCError(RPC_INVALID_PARAMETER, "peers must be between 1 and 8");
+            // The delivery loop serves at most `peers` targets; more are unreachable
+            // dead weight that only spawns joined threads, so cap the array too.
+            if (!request.params[2].isNull() && request.params[2].get_array().size() > 8) throw JSONRPCError(RPC_INVALID_PARAMETER, "at most 8 targets per call");
+            const CFeeRate max_raw_tx_fee_rate{request.params[3].isNull() ? DEFAULT_MAX_RAW_TX_FEE_RATE : CFeeRate(AmountFromValue(request.params[3]))};
+
+            NodeContext& node = EnsureAnyNodeContext(request.context);
+            ChainstateManager& chainman = EnsureChainman(node);
+            const bool regtest{chainman.GetParams().GetChainType() == ChainType::REGTEST};
+
+            // Candidate nodes: the given targets, or random known addresses. Outbound peers
+            // are deliberately NOT preferred: they are a small, stable set tied to this node's
+            // long-lived connections, so handing to them narrows the anonymity set and risks
+            // timing correlation. Use addrman diversity; fall back to outbound only if addrman is empty.
+            std::vector<CService> candidates;
+            const auto add = [&](const CService& s) {
+                if (s.IsValid() && std::find(candidates.begin(), candidates.end(), s) == candidates.end()) candidates.push_back(s);
+            };
+            if (!request.params[2].isNull()) {
+                for (const UniValue& t : request.params[2].get_array().getValues()) {
+                    const std::optional<CService> s{Lookup(t.get_str(), chainman.GetParams().GetDefaultPort(), /*fAllowLookup=*/false)};
+                    if (!s) throw JSONRPCError(RPC_INVALID_PARAMETER, "Invalid target: " + t.get_str());
+                    add(*s);
+                }
+            } else {
+                if (node.addrman) {
+                    for (int i = 0; i < 200 && candidates.size() < 16; ++i) {
+                        const auto [addr, last_try]{node.addrman->Select()};
+                        if (!addr.IsValid()) break;
+                        if (g_reachable_nets.Contains(addr)) add(addr);
+                    }
+                }
+                if (candidates.empty() && node.connman) {
+                    std::vector<CNodeStats> stats;
+                    node.connman->GetNodeStats(stats);
+                    for (const CNodeStats& s : stats) {
+                        if (!s.fInbound) add(s.addr);
+                    }
+                }
+                std::shuffle(candidates.begin(), candidates.end(), FastRandomContext());
+            }
+            if (!regtest) {
+                // Without a proxy the receiving node would see this node's IP address.
+                candidates.erase(std::remove_if(candidates.begin(), candidates.end(), [](const CService& s) { return !ShunkoTargetIsPrivate(s); }),
+                                 candidates.end());
+            }
+            if (candidates.empty()) {
+                // Keep the "Shunko needs Tor" prefix: mainnet_smoke.py matches on it.
+                Proxy onion_proxy;
+                const bool has_proxy{GetProxy(NET_ONION, onion_proxy)};
+                throw JSONRPCError(RPC_CLIENT_NODE_NOT_CONNECTED, regtest ? "No known nodes to send the transaction to" :
+                    (!has_proxy ? "Shunko needs Tor: no known node can be reached through a proxy (set proxy=127.0.0.1:9050, see deploy/)"
+                                : "Shunko needs Tor: proxy is set but no proxy-reachable peer is known yet (addrman empty) - wait for connections and retry"));
+            }
+
+            // Shunko is pointless if the wallet announces or rebroadcasts its own
+            // transactions: that would mark this node as the origin regardless of the
+            // one-shot hand-over. Refuse unless walletbroadcast=0 (no consensus change,
+            // transport-layer guard only). Checked after the Tor refusal above so the
+            // "needs Tor" error keeps firing first when no proxy peer exists.
+            // Exempt regtest so tests/shunko_regtest.py keeps passing without extra config.
+            if (!regtest && gArgs.GetBoolArg("-walletbroadcast", true)) {
+                throw JSONRPCError(RPC_INVALID_PARAMETER, "Shunko needs walletbroadcast=0 (see deploy/home/cachecoin.conf): otherwise the wallet may announce or rebroadcast the transaction and reveal this node as its origin. Set walletbroadcast=0 and build the transaction with add_to_wallet=false.");
+            }
+
+            // Check it would be accepted, without adding it to this node's mempool.
+            // Privacy: the one-shot version handshake always claims start_height 0.
+            // Sending the real tip height would leak exactly how synced this node is,
+            // so ActiveHeight() is deliberately never read here. tests/shunko_regtest.py
+            // asserts no height value, so it keeps passing with 0.
+            {
+                LOCK(cs_main);
+                const MempoolAcceptResult result{chainman.ProcessTransaction(tx, /*test_accept=*/true)};
+                if (result.m_result_type != MempoolAcceptResult::ResultType::VALID) {
+                    throw JSONRPCError(RPC_VERIFY_REJECTED, result.m_state.ToString());
+                }
+                const CAmount max_raw_tx_fee{max_raw_tx_fee_rate.GetFee(GetVirtualTransactionSize(*tx))};
+                if (max_raw_tx_fee && result.m_base_fees.value() > max_raw_tx_fee) {
+                    throw JSONRPCTransactionError(TransactionError::MAX_FEE_EXCEEDED);
+                }
+            }
+
+            // At most two rounds, each trying up to `peers` nodes at the same time with a 30 s
+            // limit, so a call never holds an RPC thread for more than about a minute.
+            UniValue attempts(UniValue::VARR);
+            int delivered{0};
+            std::string first_error;
+            size_t next{0};
+            for (int round = 0; round < 2 && delivered < peers && next < candidates.size(); ++round) {
+                std::vector<std::future<std::vector<ShunkoDelivery>>> jobs;
+                for (int i = delivered; i < peers && next < candidates.size(); ++i) {
+                    const CService target{candidates[next++]};
+                    jobs.push_back(std::async(std::launch::async, [&tx, target, &chainman] {
+                        constexpr int SHUNKO_START_HEIGHT{0};
+                        return ShunkoDeliver(*tx, {target}, chainman.GetParams(), SHUNKO_START_HEIGHT, std::chrono::seconds{30});
+                    }));
+                }
+                for (auto& job : jobs) {
+                    for (const ShunkoDelivery& r : job.get()) {
+                        UniValue a(UniValue::VOBJ);
+                        a.pushKV("target", r.target);
+                        a.pushKV("delivered", r.delivered);
+                        if (!r.delivered) {
+                            a.pushKV("error", r.error);
+                            if (first_error.empty()) first_error = r.error;
+                        }
+                        attempts.push_back(a);
+                        if (r.delivered) ++delivered;
+                    }
+                }
+            }
+            if (delivered == 0) {
+                throw JSONRPCError(RPC_CLIENT_NODE_NOT_CONNECTED, "No node could be reached; the transaction was not sent (" + first_error + ")");
+            }
+            UniValue ret(UniValue::VOBJ);
+            ret.pushKV("txid", tx->GetHash().GetHex());
+            ret.pushKV("delivered", delivered);
+            ret.pushKV("attempts", attempts);
+            return ret;
+        },
+    };
+}
