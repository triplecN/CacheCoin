 /**
  * Maximum amount of time that a block timestamp is allowed to exceed the
  * current time before the block will be accepted.
+ *
+ * CacheCoin: 10 minutes (10 x the 60 s target spacing). Bitcoin's 2 hours is 120
+ * target spacings here, which lets a dominant miner stamp about 20 blocks at LWMA's
+ * +6T solve-time clamp and cut the difficulty about 4x. At 10 minutes the timestamps
+ * can run ahead by at most two such blocks, while node clocks may still differ by
+ * several minutes.
  */
-static constexpr int64_t MAX_FUTURE_BLOCK_TIME = 2 * 60 * 60;
+static constexpr int64_t MAX_FUTURE_BLOCK_TIME = 10 * 60;
 
 /**
  * Timestamp window used as a grace period by code that compares external
  * timestamps (such as timestamps passed to RPCs, or wallet key creation times)
  * to block timestamps. This should be set at least as high as
  * MAX_FUTURE_BLOCK_TIME.
+ *
+ * CacheCoin: kept at Bitcoin's 2 hours (a wider grace period for wallet rescans
+ * only), independent of the smaller MAX_FUTURE_BLOCK_TIME.
  */
-static constexpr int64_t TIMESTAMP_WINDOW = MAX_FUTURE_BLOCK_TIME;
+static constexpr int64_t TIMESTAMP_WINDOW = 2 * 60 * 60;
+static_assert(TIMESTAMP_WINDOW >= MAX_FUTURE_BLOCK_TIME);
 //! Init values for CBlockIndex nSequenceId when loaded from disk
 static constexpr int32_t SEQ_ID_BEST_CHAIN_FROM_DISK = 0;
 static constexpr int32_t SEQ_ID_INIT_FROM_DISK = 1;
