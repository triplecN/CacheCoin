+    // CacheCoin PER: vTxFees is per-transaction (the coinbase is not in it), so the block's
+    // total fees are their sum. getTxFees() returns BY VALUE, so it must be bound to one
+    // local: calling it twice would take begin() and end() from two different temporaries
+    // (and with a non-empty mempool that segfaults).
     const std::vector<CAmount> per_tx_fees{block_template->getTxFees()};
     const CAmount total_fees{std::accumulate(per_tx_fees.begin(), per_tx_fees.end(), CAmount{0})};
     result.pushKV("coinbasefee", (int64_t)(total_fees - PerFeeShare(total_fees)));
