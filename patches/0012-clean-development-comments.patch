diff --git a/src/node/miner.cpp b/src/node/miner.cpp
index e2edaa1..43e6934 100644
--- a/src/node/miner.cpp
+++ b/src/node/miner.cpp
@@ -172,8 +172,6 @@ std::unique_ptr<CBlockTemplate> BlockAssembler::CreateNewBlock()
     // m_options.block_reserved_weight only covers the header, the tx count and the coinbase's
     // own dummy output, so these extra coinbase outputs have to be charged to the budget here,
     // before addChunks() fills the rest of the block.
-    // GetSerializeSize() no longer takes a protocol version; the one-argument
-    // form is the plain non-witness size.
     size_t per_extra_bytes = ::GetSerializeSize(PerCommitmentOutput(PerCommitment{}));
     for (const auto& o : per_extra_outs) per_extra_bytes += ::GetSerializeSize(o);
     nBlockWeight += per_extra_bytes * WITNESS_SCALE_FACTOR;
diff --git a/src/per.cpp b/src/per.cpp
index e653d96..8948446 100644
--- a/src/per.cpp
+++ b/src/per.cpp
@@ -237,11 +237,8 @@ bool PerTicketPowValid(const PerTicket& ticket, uint32_t anchor_nbits,
 
 uint256 PerTicket::Id() const
 {
-    // v31.1 port: CHashWriter was removed upstream. Its CHashWriter::operator<< did
-    // exactly `::Serialize(*this, obj)` on the HashWriter base and never emitted the
-    // nVersion it stored, so HashWriter (the surviving base class, same double-SHA256
-    // GetHash()) produces a byte-for-byte identical digest and therefore identical
-    // ticket ids. Keep this stable: PerTicket ids are consensus-relevant.
+    // Ticket ids are consensus-relevant: this is the double-SHA256 of the serialized
+    // ticket (anchor, payout, nonce). Keep it stable.
     HashWriter ss;
     ss << *this;
     return ss.GetHash();
@@ -378,8 +375,7 @@ std::optional<PerTicket> PerMineTicket(const uint256& anchor,
     if (target == 0) return std::nullopt;
     for (uint64_t n = 0; n < max_tries && n <= 0xffffffffu; ++n) {
         // Respond to shutdown promptly (a default 1M-try run is hours of hashing).
-        // v31.1 port: the global ShutdownRequested() is gone; the caller supplies the
-        // interrupt flag (ChainstateManager::m_interrupt).
+        // The caller supplies the interrupt flag (ChainstateManager::m_interrupt).
         if ((n & 1023) == 0 && interrupt && static_cast<bool>(*interrupt)) return std::nullopt;
         PerTicket t{anchor, payout, static_cast<uint32_t>(n)};
         if (UintToArith256(TicketPowHash(t)) <= target) return t;
