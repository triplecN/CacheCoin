     result.pushKV("coinbasevalue", block.vtx[0]->vout[0].nValue);
-    // CacheCoin PER: vTxFees is per-transaction in v31.1 (the coinbase is not in it), so the
-    // block's total fees are their sum. getTxFees() returns BY VALUE, so it must be
