 src/chainparamsbase.cpp    |  22 +--
 src/consensus/amount.h     |   8 +-
 src/consensus/consensus.h  |  18 ++-
 src/kernel/chainparams.cpp | 269 +++++++++++++++++--------------------
 5 files changed, 163 insertions(+), 161 deletions(-)

