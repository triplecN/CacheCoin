+/**
+ * CacheCoin mainnet genesis block: same layout as CreateGenesisBlock() above, except
+ * that the first scriptSig push is the genesis nBits (0x1e0ffff0) instead of Bitcoin's
+ * 486604799. That is the exact coinbase built by genesis_miner.py when the genesis was
+ * mined (txid = merkle root 3c80c391...), and only with it does the header hash to
+ * 1bc3387d... with nonce 1349294. Using Bitcoin's scriptSig gives a different
+ * transaction (48c33a0d...), fails the genesis asserts and aborts the node at startup.
+ */
+static CBlock CreateCacheCoinGenesisBlock(const char* pszTimestamp, const CScript& genesisOutputScript, uint32_t nTime, uint32_t nNonce, uint32_t nBits, int32_t nVersion, const CAmount& genesisReward)
+{
+    CMutableTransaction txNew;
+    txNew.version = 1;
+    txNew.vin.resize(1);
+    txNew.vout.resize(1);
+    txNew.vin[0].scriptSig = CScript() << int64_t{nBits} << CScriptNum(4) << std::vector<unsigned char>((const unsigned char*)pszTimestamp, (const unsigned char*)pszTimestamp + strlen(pszTimestamp));
+    txNew.vout[0].nValue = genesisReward;
+    txNew.vout[0].scriptPubKey = genesisOutputScript;
+
+    CBlock genesis;
+    genesis.nTime    = nTime;
+    genesis.nBits    = nBits;
+    genesis.nNonce   = nNonce;
+    genesis.nVersion = nVersion;
+    genesis.vtx.push_back(MakeTransactionRef(std::move(txNew)));
+    genesis.hashPrevBlock.SetNull();
+    genesis.hashMerkleRoot = BlockMerkleRoot(genesis);
+    return genesis;
+}
