--- a/src/chainparams.cpp
+++ b/src/chainparams.cpp
@@ -139,6 +139,13 @@ std::unique_ptr<const CChainParams> CreateChainParams(const ArgsManager& args, c
 
 void SelectParams(const ChainType chain)
 {
+    // CacheCoin defines no public test network. The testnet, testnet4 and signet
+    // parameters are still Bitcoin's (their genesis blocks fail RandomX), so refuse
+    // to run them. ChainType::TESTNET4 is listed
+    // explicitly because upstream v31.1 added it.
+    if (chain == ChainType::TESTNET || chain == ChainType::TESTNET4 || chain == ChainType::SIGNET) {
+        throw std::runtime_error("CacheCoin has no public test network: -testnet, -testnet4 and -signet are disabled. Use -regtest for local testing.");
+    }
     SelectBaseParams(chain);
     globalChainParams = CreateChainParams(gArgs, chain);
 }
