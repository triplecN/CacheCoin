+static RPCHelpMan generateperticket()
+{
+    return RPCHelpMan{"generateperticket",
+        "\nMine one PER entropy ticket for the given payout address, anchored to the current tip,\n"
+        "and add it to this node's pool so the next block can embed it. For CPU miners who want a\n"
+        "share of the epoch reservoir without having to find a full block.\n",
+        {
+            {"address", RPCArg::Type::STR, RPCArg::Optional::NO, "The CacheCoin address the ticket pays to"},
+            {"maxtries", RPCArg::Type::NUM, RPCArg::Default{1000000}, "How many nonces to try"},
+        },
+        RPCResult{RPCResult::Type::OBJ, "", "", {
+            {RPCResult::Type::BOOL, "found", "whether a ticket was found within maxtries"},
+            {RPCResult::Type::STR_HEX, "ticketid", /*optional=*/true, "the ticket's id, if found"},
+            {RPCResult::Type::STR_HEX, "anchor", /*optional=*/true, "the block it is anchored to, if found"},
+            {RPCResult::Type::BOOL, "pooled", /*optional=*/true, "whether the ticket entered this node's pool (false when the pool is full of fresh tickets)"},
+            {RPCResult::Type::NUM, "pool", "tickets now in this node's pool"},
+        }},
+        RPCExamples{HelpExampleCli("generateperticket", "\"cccn1q...\"")},
+        [&](const RPCHelpMan& self, const JSONRPCRequest& request) -> UniValue
+{
+    const CTxDestination dest = DecodeDestination(request.params[0].get_str());
+    if (!IsValidDestination(dest)) throw JSONRPCError(RPC_INVALID_ADDRESS_OR_KEY, "Invalid address");
+    const CScript payout = GetScriptForDestination(dest);
+    if (!PerPayoutScriptAllowed(payout)) throw JSONRPCError(RPC_INVALID_ADDRESS_OR_KEY, "Address type not allowed for PER tickets");
+    uint64_t tries = request.params[1].isNull() ? 1000000 : request.params[1].getInt<uint64_t>();
+
+    ChainstateManager& chainman = EnsureAnyChainman(request.context);
+    uint256 anchor;
+    uint32_t anchor_nbits;
+    const Consensus::Params& consensus = chainman.GetConsensus();
+    {
+        LOCK(cs_main);
+        const CBlockIndex* tip = chainman.ActiveChain().Tip();
+        // No tip yet (start-up before genesis load): refuse instead of dereferencing null.
+        if (!tip) throw JSONRPCError(RPC_CLIENT_IN_INITIAL_DOWNLOAD, "Node has no tip yet");
+        anchor = tip->GetBlockHash();
+        anchor_nbits = tip->nBits;
+    }
+    // v31.1 port: chainman.m_interrupt replaces the removed global ShutdownRequested().
+    const auto ticket = PerMineTicket(anchor, anchor_nbits, payout, tries, consensus, &chainman.m_interrupt);
+
+    UniValue result(UniValue::VOBJ);
+    result.pushKV("found", (bool)ticket);
+    if (ticket) {
+        std::string err;
+        {
+            LOCK(cs_main);
+            if (!PerCheckTicketForChain(*ticket, chainman.ActiveChain().Tip(), chainman.m_blockman, consensus, err)) {
+                throw JSONRPCError(RPC_VERIFY_ERROR, "mined ticket did not validate: " + err);
+            }
+        }
+        result.pushKV("ticketid", ticket->Id().GetHex());
+        result.pushKV("anchor", ticket->anchor.GetHex());
+        // A full pool of fresh tickets means this one was mined for nothing;
+        // say so instead of silently dropping it (sweep once for a retry first).
+        bool pooled{false};
+        {
+            LOCK(cs_main);
+            PerPoolSweep(chainman.ActiveChain().Tip(), chainman.m_blockman, consensus);
+            pooled = PerPoolAdd(*ticket);
+        }
+        if (pooled) {
+            EnsurePeerman(EnsureAnyNodeContext(request.context)).RelayPerTicket(*ticket);
+        }
+        result.pushKV("pooled", pooled);
+    }
+    result.pushKV("pool", (uint64_t)PerPoolSize());
+    return result;
+},
+    };
+}
