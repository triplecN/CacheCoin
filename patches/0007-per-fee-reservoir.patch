+
+// "PER\x01" + <qIqHH> (pool int64, tickets uint32, rate int64,
+// block_tickets u16, payouts u16) = 28 bytes. Script is OP_RETURN + push 28,
+// so its hex starts with 6a1c50455201 (see tests/functional_regtest.py).
+constexpr size_t PER_COMMIT_DATA_SIZE{28};
+// "PERT" + anchor(32) + payout script + nonce u32. The hex contains 50455254
+// and the payout script, so ticket relay tests can match on substrings.
+constexpr size_t PER_TICKET_OVERHEAD{4 + 32 + 4};
+// Global pool cap: tickets cost nothing to create, so never verify or hold
+// unbounded input from the network.
+constexpr size_t PER_POOL_MAX{10000};
+
+void AppendLE64(std::vector<unsigned char>& v, int64_t x)
+{
+    uint64_t u{static_cast<uint64_t>(x)};
+    for (int i = 0; i < 8; ++i) v.push_back(static_cast<unsigned char>((u >> (8 * i)) & 0xff));
+}
+
+void AppendLE32(std::vector<unsigned char>& v, uint32_t x)
+{
+    for (int i = 0; i < 4; ++i) v.push_back(static_cast<unsigned char>((x >> (8 * i)) & 0xff));
+}
+
+void AppendLE16(std::vector<unsigned char>& v, uint16_t x)
+{
+    v.push_back(static_cast<unsigned char>(x & 0xff));
+    v.push_back(static_cast<unsigned char>((x >> 8) & 0xff));
+}
+
+// NOTE: little-endian reads use Bitcoin Core's crypto/common.h helpers
+// (uint64_t ReadLE64, uint32_t ReadLE32, uint16_t ReadLE16); local copies
+// were removed because identical signatures made every call ambiguous.
+
+// CRIT-32: validated ticket-PoW ids, bounded. The verdict is a pure function
+// of ticket content + anchor difficulty (both immutable), so hits are exact.
+// Caps the per-block re-hash cost (64 tickets) during IBD and template builds.
+constexpr size_t PER_POW_CACHE_MAX{8192};
+std::mutex g_pow_mutex;
+std::set<uint256> g_pow_valid;
+std::deque<uint256> g_pow_order;
+
+/** Ticket proof-of-work target: anchor block target times the multiplier. */
+arith_uint256 TicketTarget(uint32_t anchor_nbits, uint32_t multiplier)
+{
+    arith_uint256 t;
+    bool neg{false}, over{false};
+    t.SetCompact(anchor_nbits, &neg, &over);
+    if (neg || over || t == 0) return arith_uint256{0};
+    if (multiplier <= 1) return t;
+    const arith_uint256 orig{t};
+    t *= multiplier;
+    // On overflow saturate to the maximum target (every hash passes).
+    if (t / multiplier != orig) return ~arith_uint256{0};
+    return t;
+}
+
+/** RandomX(anchor || payout || nonce) as a uint256 (little-endian). */
+uint256 TicketPowHash(const PerTicket& t)
+{
+    std::vector<unsigned char> data;
+    data.reserve(32 + t.payout.size() + 4);
+    data.insert(data.end(), t.anchor.begin(), t.anchor.end());
+    data.insert(data.end(), t.payout.begin(), t.payout.end());
+    AppendLE32(data, t.nonce);
+    std::vector<uint8_t> out{
+        RandomXEngine::GetInstance().CalculateHash(data.data(), data.size())};
+    uint256 h;
+    if (out.size() >= 32) std::memcpy(h.begin(), out.data(), 32);
+    return h;
+}
+
+/** Ticket PoW verdict, cached (pure function of content). */
+bool PerTicketPowPass(const PerTicket& ticket, uint32_t anchor_nbits,
+                      const Consensus::Params& params)
+{
+    const uint256 tid{ticket.Id()};
+    {
+        std::lock_guard<std::mutex> lock{g_pow_mutex};
+        if (g_pow_valid.count(tid)) return true;
+    }
+    const arith_uint256 target{
+        TicketTarget(anchor_nbits, params.nPerTicketTargetMultiplier)};
+    if (target == 0) return false;
+    if (UintToArith256(TicketPowHash(ticket)) > target) return false;
+    {
+        std::lock_guard<std::mutex> lock{g_pow_mutex};
+        if (g_pow_valid.insert(tid).second) {
+            g_pow_order.push_back(tid);
+            while (g_pow_order.size() > PER_POW_CACHE_MAX) {
+                g_pow_valid.erase(g_pow_order.front());
+                g_pow_order.pop_front();
+            }
+        }
+    }
+    return true;
+}
+
+/** Extract the pushed data of an OP_RETURN output. */
+bool OpReturnData(const CScript& spk, std::vector<unsigned char>& data_out)
+{
+    if (spk.empty() || spk[0] != OP_RETURN) return false;
+    if (spk.size() >= 2 && spk[1] <= 75) {
+        const size_t len{spk[1]};
+        if (spk.size() != 2 + len) return false;
+        data_out.assign(spk.begin() + 2, spk.end());
+        return true;
+    }
+    if (spk.size() >= 3 && spk[1] == OP_PUSHDATA1) {
+        const size_t len{spk[2]};
+        if (spk.size() != 3 + len) return false;
+        data_out.assign(spk.begin() + 3, spk.end());
+        return true;
+    }
+    if (spk.size() >= 4 && spk[1] == OP_PUSHDATA2) {
+        const size_t len{size_t{spk[2]} | (size_t{spk[3]} << 8)};
+        if (spk.size() != 4 + len) return false;
+        data_out.assign(spk.begin() + 4, spk.end());
+        return true;
+    }
+    return false;
+}
+
+std::optional<PerTicket> ParseTicketFromScript(const CScript& spk)
+{
+    std::vector<unsigned char> d;
+    if (!OpReturnData(spk, d)) return std::nullopt;
+    if (d.size() < PER_TICKET_OVERHEAD) return std::nullopt;
+    if (d[0] != 'P' || d[1] != 'E' || d[2] != 'R' || d[3] != 'T') {
+        return std::nullopt;
+    }
+    PerTicket t;
+    std::memcpy(t.anchor.begin(), d.data() + 4, 32);
+    const size_t payout_len{d.size() - PER_TICKET_OVERHEAD};
+    t.payout = CScript(d.begin() + 4 + 32, d.begin() + 4 + 32 + payout_len);
+    t.nonce = ReadLE32(d.data() + d.size() - 4);
+    return t;
+}
+
+std::mutex g_pool_mutex;
+std::map<uint256, PerTicket> g_pool;
+// Bumped on every pool mutation; read lock-free by getblocktemplate.
+std::atomic<uint64_t> g_pool_version{0};
+std::mutex g_state_mutex;
+std::map<uint256, PerState> g_state_cache;
+// FIFO order for the bounded caches below (front = oldest).
+std::deque<uint256> g_state_order;
+constexpr size_t PER_STATE_CACHE_MAX{4096};
+
+// HIGH-03: ticket ids already embedded per block, bounded. Keyed by block hash
+// (immutable per block) so hits are exact and misses just re-read disk; the
+// FIFO cap keeps IBD memory flat no matter how long the chain gets.
+constexpr size_t PER_EMBEDDED_CACHE_MAX{144};
+std::mutex g_embedded_mutex;
+std::map<uint256, std::vector<uint256>> g_embedded_cache;
+std::deque<uint256> g_embedded_order;
+
+/** Ticket ids embedded by pindex's block (cached, bounded). nullopt means
+ *  the block could not be read (callers treat that as retryable, not empty). */
+std::optional<std::set<uint256>> EmbeddedTicketIds(const CBlockIndex* pindex,
+                                                    const node::BlockManager& blockman)
+{
+    if (!pindex) return std::nullopt;
+    const uint256 hash{pindex->GetBlockHash()};
+    {
+        std::lock_guard<std::mutex> lock{g_embedded_mutex};
+        if (auto it{g_embedded_cache.find(hash)}; it != g_embedded_cache.end()) {
+            return std::set<uint256>(it->second.begin(), it->second.end());
+        }
+    }
+    std::set<uint256> ids;
+    if (auto t{PerBlockTickets(pindex, blockman)}) {
+        for (const auto& x : *t) ids.insert(x.Id());
+    }
+    {
+        std::lock_guard<std::mutex> lock{g_embedded_mutex};
+        g_embedded_cache[hash] = std::vector<uint256>(ids.begin(), ids.end());
+        g_embedded_order.push_back(hash);
+        while (g_embedded_order.size() > PER_EMBEDDED_CACHE_MAX) {
+            g_embedded_cache.erase(g_embedded_order.front());
+            g_embedded_order.pop_front();
+        }
+    }
+    return ids;
+}
+
+} // namespace
+
+bool PerTicketPowValid(const PerTicket& ticket, uint32_t anchor_nbits,
+                       const Consensus::Params& params)
+{
+    return PerTicketPowPass(ticket, anchor_nbits, params);
+}
+
+uint256 PerTicket::Id() const
+{
+    // v31.1 port: CHashWriter was removed upstream. Its CHashWriter::operator<< did
+    // exactly `::Serialize(*this, obj)` on the HashWriter base and never emitted the
+    // nVersion it stored, so HashWriter (the surviving base class, same double-SHA256
+    // GetHash()) produces a byte-for-byte identical digest and therefore identical
+    // ticket ids. Keep this stable: PerTicket ids are consensus-relevant.
+    HashWriter ss;
+    ss << *this;
+    return ss.GetHash();
+}
+
+CAmount PerFeeShare(CAmount fee)
+{
+    return fee / 2;
+}
+
+int PerEpoch(int height, const Consensus::Params& params)
+{
+    if (height <= 0) return 0;
+    if (params.nPerEpochBlocks <= 0) return 0;
+    return (height - 1) / params.nPerEpochBlocks;
+}
+
+PerState PerNextState(const PerState& prev, int height, CAmount fees,
+                      uint32_t nTickets, const Consensus::Params& params)
+{
+    PerState cur{prev};
+    const int epoch_blocks{params.nPerEpochBlocks};
+    if (epoch_blocks > 0 && height > 1 && ((height - 1) % epoch_blocks) == 0) {
+        // First block of a new epoch closes the previous one.
+        const CAmount rate{cur.tickets ? cur.pool / (CAmount)cur.tickets : 0};
+        cur.pool = cur.pool - rate * (CAmount)cur.tickets;
+        cur.tickets = 0;
+        cur.rate = rate;
+    }
+    cur.pool += PerFeeShare(fees);
+    cur.tickets += nTickets;
+    return cur;
+}
+
+CTxOut PerCommitmentOutput(const PerCommitment& per)
+{
+    std::vector<unsigned char> data;
+    data.reserve(PER_COMMIT_DATA_SIZE);
+    data.push_back('P');
+    data.push_back('E');
+    data.push_back('R');
+    data.push_back(0x01);
+    AppendLE64(data, per.state.pool);
+    AppendLE32(data, per.state.tickets);
+    AppendLE64(data, per.state.rate);
+    AppendLE16(data, per.block_tickets);
+    AppendLE16(data, per.payouts);
+    CScript spk;
+    spk << OP_RETURN << data;
+    return CTxOut{0, spk};
+}
+
+std::optional<PerCommitment> ParsePerCommitment(const CTransaction& tx,
+                                               size_t* index_out)
+{
+    for (size_t i = 0; i < tx.vout.size(); ++i) {
+        const CScript& spk{tx.vout[i].scriptPubKey};
+        // Exact encoding our miner produces: OP_RETURN + push 28.
+        if (spk.size() != 2 + PER_COMMIT_DATA_SIZE) continue;
+        if (spk[0] != OP_RETURN) continue;
+        if (spk[1] != PER_COMMIT_DATA_SIZE) continue;
+        if (spk[2] != 'P' || spk[3] != 'E' || spk[4] != 'R' || spk[5] != 0x01) {
+            continue;
+        }
+        const unsigned char* d{&spk[2]};
+        PerCommitment c;
+        c.state.pool = static_cast<CAmount>(ReadLE64(d + 4));
+        c.state.tickets = ReadLE32(d + 12);
+        c.state.rate = static_cast<CAmount>(ReadLE64(d + 16));
+        c.block_tickets = ReadLE16(d + 24);
+        c.payouts = ReadLE16(d + 26);
+        if (index_out) *index_out = i;
+        return c;
+    }
+    return std::nullopt;
+}
+
+CTxOut PerTicketOutput(const PerTicket& ticket)
+{
+    std::vector<unsigned char> data;
+    data.reserve(PER_TICKET_OVERHEAD + ticket.payout.size());
+    data.push_back('P');
+    data.push_back('E');
+    data.push_back('R');
+    data.push_back('T');
+    data.insert(data.end(), ticket.anchor.begin(), ticket.anchor.end());
+    data.insert(data.end(), ticket.payout.begin(), ticket.payout.end());
+    AppendLE32(data, ticket.nonce);
+    CScript spk;
+    spk << OP_RETURN << data;
+    return CTxOut{0, spk};
+}
+
+std::optional<std::vector<PerTicket>> PerBlockTickets(
+    const CBlockIndex* pindex, const node::BlockManager& blockman)
+{
+    if (!pindex) return std::nullopt;
+    CBlock block;
+    if (!blockman.ReadBlock(block, *pindex)) return std::nullopt;
+    if (block.vtx.empty()) return std::nullopt;
+    const CTransaction& cb{*block.vtx[0]};
+    // CRIT-01: only the committed range counts. PERT outputs smuggled outside
+    // [2, 2+block_tickets) were never PoW-checked at connect time and must not
+    // become payout rights one epoch later. No commitment (genesis) = no tickets.
+    size_t commit_idx{0};
+    auto per{ParsePerCommitment(cb, &commit_idx)};
+    if (!per || commit_idx != 1) return std::vector<PerTicket>{};
+    std::vector<PerTicket> out;
+    const size_t end{std::min<size_t>(2 + per->block_tickets, cb.vout.size())};
+    for (size_t i = 2; i < end; ++i) {
+        if (auto t{ParseTicketFromScript(cb.vout[i].scriptPubKey)}) out.push_back(*t);
+    }
+    return out;
+}
+
+bool PerPayoutScriptAllowed(const CScript& payout)
+{
+    if (payout.empty()) return false;
+    if (payout.IsUnspendable()) return false;
+    if (payout.size() > 100) return false;
+    return true;
+}
+
+std::optional<PerTicket> PerMineTicket(const uint256& anchor,
+                                       uint32_t anchor_nbits,
+                                       const CScript& payout,
+                                       uint64_t max_tries,
+                                       const Consensus::Params& params,
+                                       const util::SignalInterrupt* interrupt)
+{
+    if (!PerPayoutScriptAllowed(payout)) return std::nullopt;
+    const arith_uint256 target{
+        TicketTarget(anchor_nbits, params.nPerTicketTargetMultiplier)};
+    if (target == 0) return std::nullopt;
+    for (uint64_t n = 0; n < max_tries && n <= 0xffffffffu; ++n) {
+        // Respond to shutdown promptly (a default 1M-try run is hours of hashing).
+        // v31.1 port: the global ShutdownRequested() is gone; the caller supplies the
+        // interrupt flag (ChainstateManager::m_interrupt).
+        if ((n & 1023) == 0 && interrupt && static_cast<bool>(*interrupt)) return std::nullopt;
+        PerTicket t{anchor, payout, static_cast<uint32_t>(n)};
+        if (UintToArith256(TicketPowHash(t)) <= target) return t;
+    }
+    return std::nullopt;
+}
+
+bool PerCheckTicketForChain(const PerTicket& ticket, const CBlockIndex* tip,
+                            const node::BlockManager& blockman,
+                            const Consensus::Params& params, std::string& err)
+{
+    if (!PerPayoutScriptAllowed(ticket.payout)) {
+        err = "bad payout script";
+        return false;
+    }
+    if (!tip) {
+        err = "no tip";
+        return false;
+    }
+    const CBlockIndex* anchorIdx{blockman.LookupBlockIndex(ticket.anchor)};
+    if (!anchorIdx) {
+        err = "unknown anchor";
+        return false;
+    }
+    if (anchorIdx->nHeight > tip->nHeight) {
+        err = "anchor in future";
+        return false;
+    }
+    if (tip->GetAncestor(anchorIdx->nHeight) != anchorIdx) {
+        err = "anchor not on active chain";
+        return false;
+    }
+    const int diff{tip->nHeight - anchorIdx->nHeight};
+    // MED-05: relay only tickets that can still be mined. A ticket relayed at
+    // diff==window would land at dh==window+1 in the next block and be rejected
+    // there, so it would rot in the pool wasting RandomX verifies.
+    if (diff < 0 || diff >= params.nPerTicketWindow) {
+        err = "anchor outside window";
+        return false;
+    }
+    // CRIT-32: cached PoW verdict (same accept/reject as the code it replaces).
+    if (!PerTicketPowPass(ticket, anchorIdx->nBits, params)) {
+        err = "insufficient ticket work";
+        return false;
+    }
+    return true;
+}
+
+bool PerPoolHas(const uint256& ticket_id)
+{
+    std::lock_guard<std::mutex> lock{g_pool_mutex};
+    return g_pool.count(ticket_id) != 0;
+}
+
+bool PerPoolAdd(const PerTicket& ticket)
+{
+    std::lock_guard<std::mutex> lock{g_pool_mutex};
+    if (g_pool.size() >= PER_POOL_MAX) return false;
+    const uint256 id{ticket.Id()};
+    if (g_pool.count(id)) return false;
+    g_pool[id] = ticket;
+    ++g_pool_version;
+    return true;
+}
+
+uint64_t PerPoolVersion()
+{
+    return g_pool_version.load();
+}
+
+size_t PerPoolSize()
+{
+    std::lock_guard<std::mutex> lock{g_pool_mutex};
+    return g_pool.size();
+}
+
+void PerPoolSweep(const CBlockIndex* tip, const node::BlockManager& blockman,
+                  const Consensus::Params& params)
+{
+    if (!tip) return;
+    std::map<uint256, PerTicket> copy;
+    {
+        std::lock_guard<std::mutex> lock{g_pool_mutex};
+        copy = g_pool;
+    }
+    // Classify without holding g_pool_mutex (chain lookups below need no pool
+    // lock; the caller holds cs_main for the block index). Anchors unknown to
+    // us can never have entered legitimately (relay and mining both require a
+    // known anchor), so they are swept too.
+    const int nextHeight{tip->nHeight + 1};
+    std::vector<uint256> stale;
+    for (const auto& [id, t] : copy) {
+        const CBlockIndex* a{blockman.LookupBlockIndex(t.anchor)};
+        if (!a || a->nHeight >= nextHeight) { stale.push_back(id); continue; }
+        const int diff{nextHeight - a->nHeight};
+        if (diff < 1 || diff > params.nPerTicketWindow) { stale.push_back(id); continue; }
+        if (tip->GetAncestor(a->nHeight) != a) { stale.push_back(id); continue; }
+        if (!PerPayoutScriptAllowed(t.payout)) { stale.push_back(id); continue; }
+    }
+    if (stale.empty()) return;
+    {
+        std::lock_guard<std::mutex> lock{g_pool_mutex};
+        for (const auto& id : stale) g_pool.erase(id);
+        ++g_pool_version;
+    }
+}
+
+std::vector<PerTicket> PerPoolCollect(const CBlockIndex* tip,
+                                      const node::BlockManager& blockman,
+                                      const Consensus::Params& params)
+{
+    std::vector<PerTicket> out;
+    if (!tip) return out;
+    std::map<uint256, PerTicket> copy;
+    {
+        std::lock_guard<std::mutex> lock{g_pool_mutex};
+        copy = g_pool;
+    }
+    const int nextHeight{tip->nHeight + 1};
+    for (const auto& [id, t] : copy) {
+        const CBlockIndex* a{blockman.LookupBlockIndex(t.anchor)};
+        if (!a) continue;
+        if (a->nHeight >= nextHeight) continue;
+        const int diff{nextHeight - a->nHeight};
+        if (diff < 1 || diff > params.nPerTicketWindow) continue;
+        if (tip->GetAncestor(a->nHeight) != a) continue;
+        if (!PerPayoutScriptAllowed(t.payout)) continue;
+        // CRIT-31: skip tickets already embedded in recent history. Without this,
+        // a replayed ticket poisons every template (TestBlockValidity throws) and
+        // wedges this miner until the anchor ages out. Cached: no disk on hits.
+        {
+            bool embedded{false};
+            const CBlockIndex* b{tip};
+            for (int i = 0; i < params.nPerTicketWindow && b; ++i) {
+                auto hist{EmbeddedTicketIds(b, blockman)};
+                if (!hist) break;
+                if (hist->count(id)) { embedded = true; break; }
+                b = b->pprev;
+            }
+            if (embedded) continue;
+        }
+        out.push_back(t);
+        if (out.size() >= params.nPerMaxBlockTickets) break;
+    }
+    if (out.size() > params.nPerMaxBlockTickets) {
+        out.resize(params.nPerMaxBlockTickets);
+    }
+    // Opportunistic garbage collection: drops tickets this call classified as
+    // unembeddable, so the pool cannot wedge on its own stale entries.
+    PerPoolSweep(tip, blockman, params);
+    return out;
+}
+
+std::optional<PerState> GetPerState(const CBlockIndex* pindex,
+                                    const node::BlockManager& blockman)
+{
+    if (!pindex || pindex->nHeight == 0) return PerState{0, 0, 0};
+    const uint256 hash{pindex->GetBlockHash()};
+    {
+        std::lock_guard<std::mutex> lock{g_state_mutex};
+        if (auto it{g_state_cache.find(hash)}; it != g_state_cache.end()) {
+            return it->second;
+        }
+    }
+    CBlock block;
+    if (!blockman.ReadBlock(block, *pindex)) return std::nullopt;
+    if (block.vtx.empty()) return std::nullopt;
+    auto per{ParsePerCommitment(*block.vtx[0], nullptr)};
+    if (!per) return std::nullopt;
+    {
+        std::lock_guard<std::mutex> lock{g_state_mutex};
+        g_state_cache[hash] = per->state;
+        // Bound the cache (FIFO): misses just re-read disk, so eviction is safe.
+        g_state_order.push_back(hash);
+        while (g_state_order.size() > PER_STATE_CACHE_MAX) {
+            g_state_cache.erase(g_state_order.front());
+            g_state_order.pop_front();
+        }
+    }
+    return per->state;
+}
+
+void CachePerState(const CBlockIndex* pindex, const PerState& state)
+{
+    if (!pindex) return;
+    std::lock_guard<std::mutex> lock{g_state_mutex};
+    const uint256 hash{pindex->GetBlockHash()};
+    g_state_cache[hash] = state;
+    g_state_order.push_back(hash);
+    while (g_state_order.size() > PER_STATE_CACHE_MAX) {
+        g_state_cache.erase(g_state_order.front());
+        g_state_order.pop_front();
+    }
+}
+
+bool CheckPerTicketsAndPayouts(const CBlock& block, const PerCommitment& per,
+                               const CBlockIndex* pindex,
+                               const node::BlockManager& blockman,
+                               const Consensus::Params& params,
+                               BlockValidationState& state,
+                               CAmount& payouts_out,
+                               bool drop_pool)
+{
+    payouts_out = 0;
+    if (block.vtx.empty()) {
+        return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                             "bad-cb-per", "empty block");
+    }
+    if (!pindex) {
+        return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                             "bad-cb-per", "no block index");
+    }
+    const CTransaction& cb{*block.vtx[0]};
+    if (per.block_tickets > params.nPerMaxBlockTickets) {
+        return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                             "bad-cb-per-tickets", "too many tickets");
+    }
+    size_t commit_idx{0};
+    if (!ParsePerCommitment(cb, &commit_idx) || commit_idx != 1) {
+        return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                             "bad-cb-per", "commitment must be vout 1");
+    }
+    if (cb.vout[1].nValue != 0) {
+        return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                             "bad-cb-per", "commitment value must be 0");
+    }
+    if (cb.vout.size() <
+        (size_t)2 + per.block_tickets + per.payouts) {
+        return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                             "bad-cb-per", "coinbase too small");
+    }
+    // CRIT-01: PERT outputs outside the committed ticket slice never passed a
+    // PoW check; reject them so smuggled records can never mature into payouts.
+    // (Payout outputs cannot false-positive: they must equal validated,
+    // non-OP_RETURN payout scripts, checked below.)
+    for (size_t i = 0; i < cb.vout.size(); ++i) {
+        if (i >= 2 && i < (size_t)2 + per.block_tickets) continue;
+        if (ParseTicketFromScript(cb.vout[i].scriptPubKey)) {
+            return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                                 "bad-cb-per-ticket", "extra PERT outside range");
+        }
+    }
+    const CBlockIndex* parent{pindex->pprev};
+    // A ticket may be embedded only once per window: preload the ids already
+    // embedded by the previous nPerTicketWindow blocks (at most 10 block reads
+    // per connected block) so a replayed ticket pays nothing.
+    std::set<uint256> seen;
+    {
+        const CBlockIndex* a{parent};
+        for (int i = 0; i < params.nPerTicketWindow && a; ++i) {
+            auto hist{EmbeddedTicketIds(a, blockman)};
+            // Unreadable history must not silently disable replay detection
+            // (a replay could then over-mint): retryable, like the paths above.
+            if (!hist) return state.Error("cannot read ticket history");
+            seen.insert(hist->begin(), hist->end());
+            a = a->pprev;
+        }
+    }
+    std::vector<PerTicket> tickets;
+    tickets.reserve(per.block_tickets);
+    std::vector<uint256> ids;
+    ids.reserve(per.block_tickets);
+    for (uint16_t i = 0; i < per.block_tickets; ++i) {
+        const CTxOut& o{cb.vout[2 + i]};
+        if (o.nValue != 0) {
+            return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                                 "bad-cb-per-ticket", "ticket value must be 0");
+        }
+        auto t{ParseTicketFromScript(o.scriptPubKey)};
+        if (!t) {
+            return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                                 "bad-cb-per-ticket", "malformed ticket");
+        }
+        const uint256 id{t->Id()};
+        if (!seen.insert(id).second) {
+            return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                                 "bad-cb-per-ticket", "duplicate ticket");
+        }
+        std::string err;
+        if (!PerCheckTicketForChain(*t, parent, blockman, params, err)) {
+            return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                                 "bad-cb-per-ticket",
+                                 "invalid ticket: " + err);
+        }
+        const CBlockIndex* a{blockman.LookupBlockIndex(t->anchor)};
+        if (!a) {
+            return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                                 "bad-cb-per-ticket", "unknown anchor");
+        }
+        const int dh{pindex->nHeight - a->nHeight};
+        if (dh < 1 || dh > params.nPerTicketWindow) {
+            return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                                 "bad-cb-per-ticket",
+                                 "anchor outside window for this block");
+        }
+        tickets.push_back(*t);
+        ids.push_back(id);
+    }
+    for (size_t i = 1; i < ids.size(); ++i) {
+        if (!(ids[i - 1] < ids[i])) {
+            return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                                 "bad-cb-per-ticket",
+                                 "tickets not sorted by id");
+        }
+    }
+    auto prev_per{GetPerState(parent, blockman)};
+    if (!prev_per) {
+        // Disk-read failure (pruning is refused, so only corruption/transient
+        // I/O): retryable, not a consensus verdict. Never mark the block.
+        return state.Error("missing prev PER state");
+    }
+    const CAmount rate{
+        PerNextState(*prev_per, pindex->nHeight, 0, 0, params).rate};
+    if (rate < 0 || !MoneyRange(rate)) {
+        return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                             "bad-cb-per", "negative rate");
+    }
+    // MED-06: reject before the multiply below can wrap (signed overflow is
+    // UB); per.payouts is uint16_t so the division is always safe here.
+    if (per.payouts > 0 && rate > MAX_MONEY / per.payouts) {
+        return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                             "bad-cb-per-payout", "payout overflow");
+    }
+    const int src_h{pindex->nHeight - params.nPerEpochBlocks};
+    std::vector<PerTicket> src_tickets;
+    if (src_h >= 1 && rate > 0) {
+        const CBlockIndex* src{pindex->GetAncestor(src_h)};
+        if (!src) {
+            return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                                 "bad-cb-per-payout", "missing payout source");
+        }
+        auto sopt{PerBlockTickets(src, blockman)};
+        if (!sopt) {
+            // Same as above: unreadable disk is not a guilty block.
+            return state.Error("cannot read payout source");
+        }
+        src_tickets = *sopt;
+    }
+    const size_t expected{(src_h >= 1 && rate > 0) ? src_tickets.size() : 0};
+    if (per.payouts != expected) {
+        return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                             "bad-cb-per-payout", "wrong payout count");
+    }
+    for (size_t i = 0; i < src_tickets.size(); ++i) {
+        const CTxOut& o{cb.vout[2 + per.block_tickets + i]};
+        if (o.nValue != rate) {
+            return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                                 "bad-cb-per-payout", "wrong payout amount");
+        }
+        if (!(o.scriptPubKey == src_tickets[i].payout)) {
+            return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                                 "bad-cb-per-payout", "wrong payout script");
+        }
+    }
+    payouts_out = rate * (CAmount)per.payouts;
+    // MED-06: belt and suspenders after the pre-multiply overflow guard above.
+    if (!MoneyRange(payouts_out)) {
+        return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                             "bad-cb-per-payout", "payouts out of range");
+    }
+    if (payouts_out < 0) {
+        return state.Invalid(BlockValidationResult::BLOCK_CONSENSUS,
+                             "bad-cb-per-payout", "negative payouts");
+    }
+    // Confirmed tickets leave the local pool (like confirmed mempool txs), so
+    // honest miners never re-embed them while the anchor is still in window.
+    // Skipped for fJustCheck: TestBlockValidity runs on every template built by
+    // CreateNewBlock, and draining there would empty the pool before mining.
+    if (drop_pool) {
+        std::lock_guard<std::mutex> lock{g_pool_mutex};
+        for (const auto& id : ids) g_pool.erase(id);
+        if (!ids.empty()) ++g_pool_version;
+    }
+    return true;
+}
