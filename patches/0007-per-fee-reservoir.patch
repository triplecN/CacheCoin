+    const CBlockIndex* pindex{chainman.ActiveChain().Tip()};
+    if (!request.params[0].isNull()) {
+        pindex = chainman.m_blockman.LookupBlockIndex(ParseHashV(request.params[0], "blockhash"));
+        if (!pindex) throw JSONRPCError(RPC_INVALID_ADDRESS_OR_KEY, "Block not found");
+    }
+    const auto per{GetPerState(pindex, chainman.m_blockman)};
+    if (!per) throw JSONRPCError(RPC_MISC_ERROR, "PER state of this block is not available (block data missing)");
+    const Consensus::Params& consensus{chainman.GetConsensus()};
+    const int epoch{PerEpoch(pindex->nHeight, consensus)};
+    const int end{(epoch + 1) * consensus.nPerEpochBlocks};
+    UniValue result(UniValue::VOBJ);
+    result.pushKV("blockhash", pindex->GetBlockHash().GetHex());
+    result.pushKV("height", pindex->nHeight);
+    result.pushKV("epoch", epoch);
+    result.pushKV("epoch_blocks", consensus.nPerEpochBlocks);
+    result.pushKV("epoch_end_height", end);
+    result.pushKV("blocks_remaining", end - std::max(pindex->nHeight, 0));
+    result.pushKV("pool", per->pool);
