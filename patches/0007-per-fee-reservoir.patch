+                {RPCResult::Type::STR_HEX, "blockhash", "the block"},
+                {RPCResult::Type::NUM, "height", "its height"},
+                {RPCResult::Type::NUM, "epoch", "epoch number (heights 1..epoch_blocks are epoch 0)"},
+                {RPCResult::Type::NUM, "epoch_blocks", "blocks per epoch"},
+                {RPCResult::Type::NUM, "epoch_end_height", "last block of this epoch"},
+                {RPCResult::Type::NUM, "blocks_remaining", "blocks left in this epoch after this block"},
+                {RPCResult::Type::NUM, "pool", "reservoir of this epoch so far, in satoshis"},
+                {RPCResult::Type::NUM, "tickets", "tickets included in this epoch so far"},
+                {RPCResult::Type::NUM, "rate", "satoshis paid per ticket of the previous epoch during this epoch"},
+            }},
+        RPCExamples{HelpExampleCli("getperinfo", "") + HelpExampleRpc("getperinfo", "")},
+        [&](const RPCHelpMan& self, const JSONRPCRequest& request) -> UniValue
+{
+    ChainstateManager& chainman = EnsureAnyChainman(request.context);
