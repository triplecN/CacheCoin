+ * At the first block of a new epoch the previous reservoir is divided
+ * equally among its tickets (rate); each ticket is paid one epoch later.
+ * The coinbase commits to all of it, so every node verifies the same math.
+ */
+
+/** Reservoir state after a block. */
+struct PerState {
+    CAmount pool{0};
+    uint32_t tickets{0};
+    CAmount rate{0};
+    bool operator==(const PerState& o) const
+    {
+        return pool == o.pool && tickets == o.tickets && rate == o.rate;
+    }
+    bool operator!=(const PerState& o) const { return !(*this == o); }
+};
+
+/** One entropy ticket: anchor block, payout script, nonce. */
+struct PerTicket {
+    uint256 anchor;
+    CScript payout;
+    uint32_t nonce{0};
+
+    uint256 Id() const;
+
+    SERIALIZE_METHODS(PerTicket, obj)
+    {
+        READWRITE(obj.anchor, obj.payout, obj.nonce);
+    }
+};
+
+/** What the coinbase commits to. */
+struct PerCommitment {
+    PerState state;
+    uint16_t block_tickets{0};
+    uint16_t payouts{0};
+};
+
+/** Half of the fees (integer floor) goes to the reservoir. */
+CAmount PerFeeShare(CAmount fee);
+
+/** Epoch number: heights 1..epoch_blocks are epoch 0. */
+int PerEpoch(int height, const Consensus::Params& params);
+
+/**
+ * Next reservoir state. At the first block of a new epoch the previous
+ * reservoir is divided: rate = pool / tickets (0 if no tickets), the
+ * remainder carries over and the ticket count resets. Then the fee share
+ * is added and the new block tickets counted. Rate is unchanged otherwise.
+ */
+PerState PerNextState(const PerState& prev, int height, CAmount fees,
+                      uint32_t nTickets, const Consensus::Params& params);
+
+/** Coinbase output committing to the reservoir state (value 0). */
+CTxOut PerCommitmentOutput(const PerCommitment& per);
+
+/** Find the commitment in a coinbase; index_out gets its vout index. */
+std::optional<PerCommitment> ParsePerCommitment(const CTransaction& tx,
+                                               size_t* index_out = nullptr);
+
+/** Coinbase output recording one ticket (value 0, contains "PERT"). */
+CTxOut PerTicketOutput(const PerTicket& ticket);
+
+/** Tickets embedded by the block at pindex (nullopt when unreadable). */
+std::optional<std::vector<PerTicket>> PerBlockTickets(
+    const CBlockIndex* pindex, const node::BlockManager& blockman);
+
+/** Payout scripts must be spendable and small (no OP_RETURN, no bloat). */
+bool PerPayoutScriptAllowed(const CScript& payout);
+
+/** Try nonces [0, max_tries); first hash meeting the ticket target wins.
+ *  If interrupt is non-null and set, the search stops early. */
+std::optional<PerTicket> PerMineTicket(const uint256& anchor,
+                                       uint32_t anchor_nbits,
+                                       const CScript& payout,
+                                       uint64_t max_tries,
+                                       const Consensus::Params& params,
+                                       const util::SignalInterrupt* interrupt = nullptr);
+
+/** Check a ticket against the active tip (window, PoW, payout). */
+bool PerCheckTicketForChain(const PerTicket& ticket, const CBlockIndex* tip,
+                            const node::BlockManager& blockman,
+                            const Consensus::Params& params, std::string& err);
+
+/** Proof-of-work check only (lock-free): ticket hash meets anchor target.
+ *  Used by the P2P handler so the ~20 ms RandomX hash never runs under cs_main
+ *  (which would stall block connect, mempool, RPC and scheduler). */
+bool PerTicketPowValid(const PerTicket& ticket, uint32_t anchor_nbits,
+                       const Consensus::Params& params);
+
+/** In-memory ticket pool (DoS: unverified relay input, capped). */
+bool PerPoolHas(const uint256& ticket_id);
+bool PerPoolAdd(const PerTicket& ticket);
+size_t PerPoolSize();
+/** Monotonic counter bumped on every pool mutation (add, sweep-erase, connect
+ *  drain). getblocktemplate rebuilds when it changes, so relayed tickets show
+ *  up without waiting for the mempool-based cache timeout. Lock-free. */
+uint64_t PerPoolVersion();
+/** Erase entries that can never be embedded again (stale anchor, bad chain,
+ *  bad payout). Caller must hold cs_main. Without this the pool fills with
+ *  its own stale tickets (~a week of the documented ticket loop) and stops
+ *  accepting anything. */
+void PerPoolSweep(const CBlockIndex* tip, const node::BlockManager& blockman,
+                  const Consensus::Params& params);
+std::vector<PerTicket> PerPoolCollect(const CBlockIndex* tip,
+                                      const node::BlockManager& blockman,
+                                      const Consensus::Params& params);
+
+/** Reservoir state committed by pindex (nullopt when unavailable). */
+std::optional<PerState> GetPerState(const CBlockIndex* pindex,
+                                    const node::BlockManager& blockman);
+void CachePerState(const CBlockIndex* pindex, const PerState& state);
+
+/**
+ * Validate the ticket records and payout outputs of a block.
+ * Sets payouts_out to the total reservoir payout (added to blockReward).
+ * When drop_pool is true (real connect, NOT fJustCheck/TestBlockValidity),
+ * embedded tickets leave the local pool; template creation must never drain.
+ */
+bool CheckPerTicketsAndPayouts(const CBlock& block, const PerCommitment& per,
+                               const CBlockIndex* pindex,
+                               const node::BlockManager& blockman,
+                               const Consensus::Params& params,
+                               BlockValidationState& state,
+                               CAmount& payouts_out,
+                               bool drop_pool = true);
+
+#endif // BITCOIN_PER_H
