@@ -256,6 +256,16 @@ ChainstateLoadResult VerifyLoadedChainstate(ChainstateManager& chainman, const C
                                                          "This may be due to your computer's date and time being set incorrectly. "
                                                          "Only rebuild the block database if you are sure that your computer's date and time are correct")};
             }
+            // A clock behind by more than MAX_FUTURE_BLOCK_TIME but less than
+            // TIMESTAMP_WINDOW passes the fatal check above, yet consensus rejects
+            // every new block as "time-too-new" until the clock catches up. Warn
+            // now, so a stuck node is not mistaken for a network problem.
+            if (tip && tip->nTime > GetTime() + MAX_FUTURE_BLOCK_TIME) {
+                LogWarning("This node's clock is behind the chain tip by %d seconds. Consensus rejects blocks more than "
+                           "%d seconds in the future, so this node will not follow the chain until its clock is fixed. "
+                           "Enable NTP or correct the system time, then restart.",
+                           tip->nTime - GetTime(), MAX_FUTURE_BLOCK_TIME);
+            }
 
             VerifyDBResult result = CVerifyDB(chainman.GetNotifications()).VerifyDB(
                 *chainstate, chainman.GetConsensus(), chainstate->CoinsDB(),
