+namespace {
+// Rotating memory of recently used Shunko targets (auto-selected only). Handing
+// every transaction to the same receiver lets that receiver profile the sender
+// (timing, amounts) even when it cannot link the hand-over to an IP.
+std::mutex g_shunko_recent_mutex;
+std::deque<CService> g_shunko_recent;
+constexpr size_t SHUNKO_RECENT_TARGETS{16};
+} // namespace
+
 static RPCHelpMan shunkobroadcast()
 {
     return RPCHelpMan{"shunkobroadcast",
@@ -221,11 +232,21 @@ static RPCHelpMan shunkobroadcast()
             ChainstateManager& chainman = EnsureChainman(node);
             const bool regtest{chainman.GetParams().GetChainType() == ChainType::REGTEST};
 
-            // Candidate nodes: the given targets, or random known addresses. Outbound peers
-            // are deliberately NOT preferred: they are a small, stable set tied to this node's
-            // long-lived connections, so handing to them narrows the anonymity set and risks
-            // timing correlation. Use addrman diversity; fall back to outbound only if addrman is empty.
+            // Candidate nodes: the given targets, or random known addresses. Peers this
+            // node is already connected to are excluded: the point of Shunko is a one-shot
+            // connection the receiver cannot tie to this node's long-lived ones, and a
+            // connected peer is the easiest node to tie it to. (The old code excluded
+            // nothing on the addrman path and fell back to this node's own outbound peers.)
             std::vector<CService> candidates;
+            std::vector<CService> connected;
+            if (node.connman) {
+                std::vector<CNodeStats> stats;
+                node.connman->GetNodeStats(stats);
+                for (const CNodeStats& s : stats) connected.push_back(s.addr);
+            }
+            const auto is_connected = [&](const CService& s) {
+                return std::find(connected.begin(), connected.end(), s) != connected.end();
+            };
             const auto add = [&](const CService& s) {
                 if (s.IsValid() && std::find(candidates.begin(), candidates.end(), s) == candidates.end()) candidates.push_back(s);
             };
@@ -240,14 +261,7 @@ static RPCHelpMan shunkobroadcast()
                     for (int i = 0; i < 200 && candidates.size() < 16; ++i) {
                         const auto [addr, last_try]{node.addrman->Select()};
                         if (!addr.IsValid()) break;
-                        if (g_reachable_nets.Contains(addr)) add(addr);
-                    }
-                }
-                if (candidates.empty() && node.connman) {
-                    std::vector<CNodeStats> stats;
-                    node.connman->GetNodeStats(stats);
-                    for (const CNodeStats& s : stats) {
-                        if (!s.fInbound) add(s.addr);
+                        if (g_reachable_nets.Contains(addr) && !is_connected(addr)) add(addr);
                     }
                 }
                 std::shuffle(candidates.begin(), candidates.end(), FastRandomContext());
@@ -263,13 +277,23 @@ static RPCHelpMan shunkobroadcast()
                                                 [&](const CService& s) { return !(clearnet_ok && s.IsLocal()) && !ShunkoTargetIsPrivate(s); }),
                                  candidates.end());
             }
+            if (request.params[2].isNull()) {
+                // Rotation: prefer targets not used in the last few calls, unless that
+                // would leave nothing (tiny networks); explicit targets are left alone.
+                std::lock_guard<std::mutex> lock{g_shunko_recent_mutex};
+                std::vector<CService> fresh;
+                for (const CService& s : candidates) {
+                    if (std::find(g_shunko_recent.begin(), g_shunko_recent.end(), s) == g_shunko_recent.end()) fresh.push_back(s);
+                }
+                if (!fresh.empty()) candidates = std::move(fresh);
+            }
             if (candidates.empty()) {
                 // Keep the "Shunko needs Tor" prefix: mainnet_smoke.py matches on it.
                 Proxy onion_proxy;
                 const bool has_proxy{GetProxy(NET_ONION, onion_proxy)};
                 throw JSONRPCError(RPC_CLIENT_NODE_NOT_CONNECTED, regtest ? "No known nodes to send the transaction to" :
                     (!has_proxy ? "Shunko needs Tor: no known node can be reached through a proxy (set proxy=127.0.0.1:9050, see deploy/)"
-                                : "Shunko needs Tor: proxy is set but no proxy-reachable peer is known yet (addrman empty) - wait for connections and retry"));
+                                : "Shunko needs Tor: proxy is set but no proxy-reachable peer is known yet (addrman empty, or every known peer is already connected) - wait for connections and retry"));
             }
 
             // Shunko is pointless if the wallet announces or rebroadcasts its own
@@ -305,10 +329,12 @@ static RPCHelpMan shunkobroadcast()
             int delivered{0};
             std::string first_error;
             size_t next{0};
+            std::vector<CService> used;
             for (int round = 0; round < 2 && delivered < peers && next < candidates.size(); ++round) {
                 std::vector<std::future<std::vector<ShunkoDelivery>>> jobs;
                 for (int i = delivered; i < peers && next < candidates.size(); ++i) {
                     const CService target{candidates[next++]};
+                    used.push_back(target);
                     jobs.push_back(std::async(std::launch::async, [&tx, target, &chainman] {
                         constexpr int SHUNKO_START_HEIGHT{0};
                         return ShunkoDeliver(*tx, {target}, chainman.GetParams(), SHUNKO_START_HEIGHT, std::chrono::seconds{30});
@@ -328,6 +354,13 @@ static RPCHelpMan shunkobroadcast()
                     }
                 }
             }
+            if (request.params[2].isNull() && !used.empty()) {
+                std::lock_guard<std::mutex> lock{g_shunko_recent_mutex};
+                for (const CService& s : used) {
+                    g_shunko_recent.push_back(s);
+                    while (g_shunko_recent.size() > SHUNKO_RECENT_TARGETS) g_shunko_recent.pop_front();
+                }
+            }
             if (delivered == 0) {
                 throw JSONRPCError(RPC_CLIENT_NODE_NOT_CONNECTED, "No node could be reached; the transaction was not sent (" + first_error + ")");
             }
diff --git a/src/test/fuzz/per.cpp b/src/test/fuzz/per.cpp
