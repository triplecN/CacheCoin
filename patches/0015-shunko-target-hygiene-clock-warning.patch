--- a/src/test/fuzz/per.cpp
+++ b/src/test/fuzz/per.cpp
@@ -47,6 +47,34 @@ FUZZ_TARGET(per_ticket_roundtrip)
     (void)PerPayoutScriptAllowed(ticket.payout);
 }
 
+FUZZ_TARGET(per_ticket_deserialize)
+{
+    // Raw bytes straight into the ticket deserializer: a block can carry arbitrary
+    // ticket-record bytes, so this path must never crash, over-read, or hand a
+    // half-decoded ticket to consensus.
+    PerTicket ticket;
+    try {
+        SpanReader{buffer} >> ticket;
+    } catch (const std::ios_base::failure&) {
+        return;
+    }
+    const uint256 id{ticket.Id()};
+    DataStream reencoded{};
+    reencoded << ticket;
+    PerTicket decoded;
+    try {
+        reencoded >> decoded;
+    } catch (const std::ios_base::failure&) {
+        assert(false);
+        return;
+    }
+    assert(decoded.anchor == ticket.anchor);
+    assert(decoded.payout == ticket.payout);
+    assert(decoded.nonce == ticket.nonce);
+    assert(decoded.Id() == id);
+    (void)PerPayoutScriptAllowed(ticket.payout);
+}
+
