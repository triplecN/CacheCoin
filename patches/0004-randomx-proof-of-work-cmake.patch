+uint256 CBlockHeader::GetPoWHash() const
+{
+    // CacheCoin: CDataStream is gone in v31.x, but the consensus input is unchanged: the
+    // 80-byte serialization of the header, hashed with RandomX v1.
+    DataStream ss{};
+    ss << *this;
+    assert(ss.size() == 80);
+
+    std::vector<uint8_t> pow_digest = RandomXEngine::GetInstance().CalculateHash(
+        reinterpret_cast<const uint8_t*>(ss.data()), ss.size()
+    );
+
+    uint256 result;
+    std::memcpy(result.begin(), pow_digest.data(), 32);
+    return result;
+}
