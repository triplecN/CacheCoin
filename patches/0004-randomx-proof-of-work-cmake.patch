diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6109639..0c30321 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -616,6 +616,49 @@ if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.29)
   set(CMAKE_SKIP_TEST_ALL_DEPENDENCY FALSE)
 endif()
 
+#=============================
+# CacheCoin: RandomX proof-of-work
+#=============================
+# CacheCoin replaces SHA256d with RandomX v1 (light mode) as the proof-of-work hash.
+# RandomX is a separate upstream project (tevador/RandomX), pinned to an exact commit
+# and built by scripts/build_linux.sh *before* Bitcoin Core is configured, so it is
+# consumed here as a prebuilt static library rather than with add_subdirectory():
+# RandomX's own CMakeLists.txt would additionally create an install() rule and three
+# executables (randomx-tests, randomx-codegen, randomx-benchmark) that this build does
+# not want. The `randomx` target defined below replaces the three autotools hunks of
+# patches/0003-randomx-proof-of-work.patch: the -I for randomx/src, the
+# crypto/randomx_wrapper.{h,cpp} sources, and the librandomx.a on the link line.
+option(CACHECOIN_RANDOMX "Build CacheCoin's RandomX proof of work. ON consumes the pinned RandomX checkout under src/crypto/randomx; OFF expects a system-installed RandomX." ON)
+set(CACHECOIN_RANDOMX_ROOT "${PROJECT_SOURCE_DIR}/src/crypto/randomx" CACHE PATH "Root of the pinned RandomX checkout (provides src/randomx.h and build/librandomx.a).")
+if(CACHECOIN_RANDOMX)
+  if(NOT EXISTS "${CACHECOIN_RANDOMX_ROOT}/src/randomx.h")
+    message(FATAL_ERROR "CacheCoin: RandomX headers not found at '${CACHECOIN_RANDOMX_ROOT}/src/randomx.h'. RandomX is consensus-critical and is not vendored: build it first (see scripts/build_linux.sh), point -DCACHECOIN_RANDOMX_ROOT=<path> at an existing checkout, or configure with -DCACHECOIN_RANDOMX=OFF to use a system-installed RandomX.")
+  endif()
+  set(_cachecoin_randomx_archive "${CACHECOIN_RANDOMX_ROOT}/build/${CMAKE_STATIC_LIBRARY_PREFIX}randomx${CMAKE_STATIC_LIBRARY_SUFFIX}")
+  if(NOT EXISTS "${_cachecoin_randomx_archive}")
+    message(FATAL_ERROR "CacheCoin: prebuilt librandomx.a not found at '${_cachecoin_randomx_archive}'. RandomX must be built (and self-tested) before configuring Bitcoin Core; see scripts/build_linux.sh.")
+  endif()
+  add_library(randomx STATIC IMPORTED GLOBAL)
+  set_target_properties(randomx PROPERTIES
+    IMPORTED_LOCATION "${_cachecoin_randomx_archive}"
+    INTERFACE_INCLUDE_DIRECTORIES "${CACHECOIN_RANDOMX_ROOT}/src"
+  )
+  message(STATUS "CacheCoin: using RandomX from ${CACHECOIN_RANDOMX_ROOT}")
+else()
+  find_path(CACHECOIN_RANDOMX_INCLUDE_DIR randomx.h)
+  find_library(CACHECOIN_RANDOMX_LIBRARY NAMES randomx)
+  if(NOT CACHECOIN_RANDOMX_INCLUDE_DIR OR NOT CACHECOIN_RANDOMX_LIBRARY)
+    message(FATAL_ERROR "CacheCoin: -DCACHECOIN_RANDOMX=OFF requires a system-installed RandomX, but randomx.h and/or librandomx were not found. RandomX is consensus-critical and has no fallback algorithm.")
+  endif()
+  add_library(randomx STATIC IMPORTED GLOBAL)
+  set_target_properties(randomx PROPERTIES
+    IMPORTED_LOCATION "${CACHECOIN_RANDOMX_LIBRARY}"
+    INTERFACE_INCLUDE_DIRECTORIES "${CACHECOIN_RANDOMX_INCLUDE_DIR}"
+  )
+  message(STATUS "CacheCoin: using system RandomX ${CACHECOIN_RANDOMX_LIBRARY}")
+endif()
+unset(_cachecoin_randomx_archive)
+
 add_subdirectory(test)
 add_subdirectory(doc)
 
