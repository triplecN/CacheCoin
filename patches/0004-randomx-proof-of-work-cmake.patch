diff --git a/src/crypto/randomx_wrapper.cpp b/src/crypto/randomx_wrapper.cpp
new file mode 100644
index 0000000..2548eee
--- /dev/null
+++ b/src/crypto/randomx_wrapper.cpp
@@ -0,0 +1,185 @@
+// Copyright (c) 2026 triplecN
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <crypto/randomx_wrapper.h>
+
+#include <randomx.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#ifndef _WIN32
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
+namespace {
+
+// Consensus key of the RandomX cache. Changing it changes the proof-of-work of every
+// block, including genesis (nonce 1349294 was found with this key).
+constexpr char RANDOMX_POW_KEY[] = "CacheCoin CCCN Genesis Seed Key";
+
+[[noreturn]] void RandomXFatal(const char* what)
+{
+    std::fprintf(stderr, "CacheCoin: fatal RandomX error: %s. Refusing to continue without the consensus proof-of-work.\n", what);
+    std::abort();
+}
+
+/**
+ * Whether this process may turn freshly written memory into executable code, which the
+ * RandomX JIT needs. Hardened systems refuse that (systemd MemoryDenyWriteExecute, SELinux
+ * execmem, PaX MPROTECT), and the RandomX library ignores the refusal (it discards the
+ * mprotect result), so the first jump into JIT code would crash the node with SIGSEGV.
+ * Probe the same transitions RANDOMX_FLAG_SECURE uses: read-write -> read-execute -> read-write.
+ */
+bool JitMemoryAllowed()
+{
+#ifdef _WIN32
+    return true;
+#else
+    const long page_size{sysconf(_SC_PAGESIZE)};
+    if (page_size <= 0) return false;
+    void* page{mmap(nullptr, page_size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0)};
+    if (page == MAP_FAILED) return false;
+    const bool to_exec{mprotect(page, page_size, PROT_READ | PROT_EXEC) == 0};
+    const bool to_write{to_exec && mprotect(page, page_size, PROT_READ | PROT_WRITE) == 0};
+    munmap(page, page_size);
+    return to_exec && to_write;
+#endif
+}
+
+class RandomXContext
+{
+public:
+    RandomXContext()
+    {
+        // CPU feature flags (JIT, AES, Argon2 variants) only change speed, never the hash.
+        // RANDOMX_FLAG_V2 selects a different algorithm and must never be set: CacheCoin
+        // consensus is RandomX v1.
+        m_flags = static_cast<randomx_flags>(randomx_get_flags() & ~RANDOMX_FLAG_V2);
+        if (m_flags & RANDOMX_FLAG_JIT) {
+            const char* no_jit{std::getenv("CACHECOIN_RANDOMX_NOJIT")};
+            if (no_jit != nullptr && *no_jit != '\0' && std::strcmp(no_jit, "0") != 0) {
+                m_flags = static_cast<randomx_flags>(m_flags & ~(RANDOMX_FLAG_JIT | RANDOMX_FLAG_SECURE));
+                m_mode = "interpreter (CACHECOIN_RANDOMX_NOJIT is set)";
+            } else if (!JitMemoryAllowed()) {
+                m_flags = static_cast<randomx_flags>(m_flags & ~(RANDOMX_FLAG_JIT | RANDOMX_FLAG_SECURE));
+                m_mode = "interpreter (this system does not allow JIT memory)";
+            } else {
+                // W^X: generated code pages are writable or executable, never both at once.
+                m_flags = static_cast<randomx_flags>(m_flags | RANDOMX_FLAG_SECURE);
+                m_mode = "JIT (W^X)";
+            }
+        } else {
+            m_mode = "interpreter (no JIT for this CPU)";
+        }
+        m_cache = randomx_alloc_cache(m_flags);
+        if (m_cache == nullptr) {
+            m_flags = RANDOMX_FLAG_DEFAULT;
+            m_mode = "interpreter (cache allocation with CPU-specific flags failed)";
+            m_cache = randomx_alloc_cache(m_flags);
+        }
+        if (m_cache == nullptr) RandomXFatal("cannot allocate the 256 MiB RandomX cache");
+        randomx_init_cache(m_cache, RANDOMX_POW_KEY, sizeof(RANDOMX_POW_KEY) - 1);
+    }
+
+    // RandomX VMs are not thread-safe, so every concurrent caller takes its own VM from
+    // this pool. The pool only grows to the number of threads that hash at the same time.
+    randomx_vm* Acquire()
+    {
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            if (!m_free.empty()) {
+                randomx_vm* vm = m_free.back();
+                m_free.pop_back();
+                return vm;
+            }
+        }
+        randomx_vm* vm = randomx_create_vm(m_flags, m_cache, nullptr);
+        if (vm == nullptr) {
+            // The interpreter produces identical hashes if a JIT VM cannot be created.
+            const auto no_jit = static_cast<randomx_flags>(m_flags & ~(RANDOMX_FLAG_JIT | RANDOMX_FLAG_SECURE));
+            vm = randomx_create_vm(no_jit, m_cache, nullptr);
+        }
+        if (vm == nullptr) RandomXFatal("cannot create a RandomX virtual machine");
+        return vm;
+    }
+
+    // Cap idle VMs: the pool would otherwise grow to peak concurrency ever seen
+    // and hold it forever (each idle VM pins megabytes of scratchpad).
+    static constexpr size_t MAX_IDLE_VMS{16};
+    void Release(randomx_vm* vm)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_free.size() >= MAX_IDLE_VMS) {
+            randomx_destroy_vm(vm);
+            return;
+        }
+        m_free.push_back(vm);
+    }
+
+    const std::string& Mode() const { return m_mode; }
+
+private:
+    randomx_flags m_flags{RANDOMX_FLAG_DEFAULT};
+    std::string m_mode;
+    randomx_cache* m_cache{nullptr};
+    std::mutex m_mutex;
+    std::vector<randomx_vm*> m_free;
+};
+
+RandomXContext& GetContext()
+{
+    // Intentionally never destroyed: validation and RPC threads may still be hashing
+    // while static destructors run at shutdown.
+    static RandomXContext* const ctx = new RandomXContext();
+    return *ctx;
+}
+
+} // namespace
+
+RandomXEngine& RandomXEngine::GetInstance()
+{
+    static RandomXEngine instance;
+    return instance;
+}
+
+std::vector<uint8_t> RandomXEngine::CalculateHash(const uint8_t* data, size_t len)
+{
+    RandomXContext& ctx = GetContext();
+    randomx_vm* vm = ctx.Acquire();
+    std::vector<uint8_t> out(RANDOMX_HASH_SIZE);
+    randomx_calculate_hash(vm, data, len, out.data());
+    ctx.Release(vm);
+    return out;
+}
+
+bool RandomXSelfTest()
+{
+    // The CacheCoin mainnet genesis header (nonce 1349294) and its RandomX digest, which
+    // meets the genesis target 0x1e0ffff0. Computed with the JIT, the interpreter and the
+    // portable build; they must all agree.
+    static constexpr uint8_t GENESIS_HEADER[80] = {
+        0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+        0x00, 0x00, 0x00, 0x00, 0xd8, 0x5e, 0xaf, 0xf5, 0xf4, 0x32, 0xf2, 0x09, 0x42, 0xeb, 0xe7, 0xac,
+        0xa4, 0x58, 0x19, 0xb8, 0x20, 0x20, 0xcb, 0x1a, 0xc1, 0xdb, 0xd9, 0xdd, 0xe4, 0x9c, 0x67, 0xde,
+        0x91, 0xc3, 0x80, 0x3c, 0x8e, 0xbc, 0xb6, 0x6a, 0xf0, 0xff, 0x0f, 0x1e, 0xae, 0x96, 0x14, 0x00,
+    };
+    static constexpr uint8_t GENESIS_POW_HASH[32] = {
+        0xe4, 0x35, 0x3b, 0xfd, 0x11, 0x83, 0x23, 0x5a, 0x27, 0xe2, 0x23, 0xc3, 0x43, 0x1f, 0xc4, 0x4f,
+        0x7b, 0x29, 0xa4, 0x9f, 0x89, 0xa6, 0x00, 0xd3, 0x08, 0xaf, 0x63, 0x27, 0xfb, 0x0e, 0x00, 0x00,
+    };
+    const std::vector<uint8_t> hash{RandomXEngine::GetInstance().CalculateHash(GENESIS_HEADER, sizeof(GENESIS_HEADER))};
+    return hash.size() == sizeof(GENESIS_POW_HASH) && std::memcmp(hash.data(), GENESIS_POW_HASH, sizeof(GENESIS_POW_HASH)) == 0;
+}
+
+std::string RandomXModeDescription()
+{
+    return GetContext().Mode();
+}
diff --git a/src/crypto/randomx_wrapper.h b/src/crypto/randomx_wrapper.h
new file mode 100644
index 0000000..dc98554
--- /dev/null
+++ b/src/crypto/randomx_wrapper.h
@@ -0,0 +1,52 @@
+// Copyright (c) 2026 triplecN
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_CRYPTO_RANDOMX_WRAPPER_H
+#define BITCOIN_CRYPTO_RANDOMX_WRAPPER_H
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+/**
+ * CacheCoin proof-of-work: RandomX v1 (tevador/RandomX) in light mode over the
+ * 80-byte serialized block header, with a fixed consensus key (see the .cpp).
+ *
+ * Consensus-critical. Every node must compute exactly this function, so there is
+ * deliberately no fallback algorithm: if RandomX cannot be initialised the process
+ * aborts instead of silently validating blocks with a different hash.
+ *
+ * The JIT compiler is used when the system allows JIT memory, with W^X pages
+ * (RANDOMX_FLAG_SECURE); otherwise, or when the environment variable
+ * CACHECOIN_RANDOMX_NOJIT is set, the interpreter runs. Both give identical hashes.
+ *
+ * Thread-safe: each concurrent caller borrows its own RandomX VM; all VMs share one
+ * read-only 256 MiB cache, so hashing on one thread never blocks another.
+ */
+class RandomXEngine
+{
+public:
+    static RandomXEngine& GetInstance();
+
+    /** Return the 32-byte RandomX hash of data[0..len). */
+    std::vector<uint8_t> CalculateHash(const uint8_t* data, size_t len);
+
+private:
+    RandomXEngine() = default;
+    RandomXEngine(const RandomXEngine&) = delete;
+    RandomXEngine& operator=(const RandomXEngine&) = delete;
+};
+
+/**
+ * Known-answer test: hash the mainnet genesis header and compare the result with its
+ * known RandomX digest. False means this build computes a different function on this
+ * system (for example a miscompiled library), so it must not validate blocks.
+ */
+bool RandomXSelfTest();
+
+/** How RandomX runs on this system (JIT or interpreter, and why), for the log. */
+std::string RandomXModeDescription();
+
+#endif // BITCOIN_CRYPTO_RANDOMX_WRAPPER_H
