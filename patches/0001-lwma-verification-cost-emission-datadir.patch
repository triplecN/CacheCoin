+namespace {
+/**
+ * CacheCoin: the proof of work is RandomX, which costs milliseconds per header where
+ * Bitcoin's SHA256d costs microseconds, and Bitcoin Core checks the same header several
+ * times (headers message, AcceptBlockHeader, ProcessNewBlock, compact blocks). This set
+ * remembers, by block hash, headers whose proof of work is known to be valid. The block
+ * hash commits to all 80 header bytes and the check is a pure function of them, so a
+ * hit is exact. Only successes are stored, and the oldest entries are evicted first.
+ */
+class PoWValidCache
+{
+    static constexpr size_t MAX_ENTRIES{20000};
+    Mutex m_mutex;
+    std::unordered_set<uint256, BlockHasher> m_set GUARDED_BY(m_mutex);
+    std::deque<uint256> m_order GUARDED_BY(m_mutex);
+
+public:
+    bool Contains(const uint256& block_hash) EXCLUSIVE_LOCKS_REQUIRED(!m_mutex)
+    {
+        LOCK(m_mutex);
+        return m_set.count(block_hash) != 0;
+    }
+
+    void Insert(const uint256& block_hash) EXCLUSIVE_LOCKS_REQUIRED(!m_mutex)
+    {
+        LOCK(m_mutex);
+        if (!m_set.insert(block_hash).second) return;
+        m_order.push_back(block_hash);
+        if (m_order.size() > MAX_ENTRIES) {
+            m_set.erase(m_order.front());
+            m_order.pop_front();
+        }
+    }
+};
+
+PoWValidCache g_pow_valid_cache;
+
+/** Whether the header's RandomX proof of work meets its nBits, using g_pow_valid_cache. */
+bool CheckHeaderProofOfWork(const CBlockHeader& header, const Consensus::Params& params)
+{
+    // An out-of-range target is rejected without evaluating RandomX.
+    if (!CheckProofOfWorkRange(header.nBits, params)) return false;
+    const uint256 block_hash{header.GetHash()};
+    if (g_pow_valid_cache.Contains(block_hash)) return true;
+    if (!CheckProofOfWork(header.GetPoWHash(), header.nBits, params)) return false;
+    g_pow_valid_cache.Insert(block_hash);
+    return true;
+}
