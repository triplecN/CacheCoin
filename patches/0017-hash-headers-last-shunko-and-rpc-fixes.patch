 src/net_processing.cpp | 47 ++++++++++++++++++++++++++++++++++++++++--
 src/rpc/client.cpp     |  2 ++
 src/rpc/mempool.cpp    | 14 +++++++++++++
 src/rpc/mining.cpp     | 20 ++++++++++++++----
 src/shunko.cpp         | 18 +++++++++++-----
 src/shunko.h           |  3 +++
 7 files changed, 102 insertions(+), 11 deletions(-)

diff --git a/src/init.cpp b/src/init.cpp
index 449b187..5ef5669 100644
--- a/src/init.cpp
+++ b/src/init.cpp
@@ -1015,6 +1015,15 @@ bool AppInitParameterInteraction(const ArgsManager& args)
         return InitError(Untranslated("CacheCoin does not support -prune: PER consensus needs full block history to verify epoch payouts."));
     }
 
+    // CacheCoin PER: the upstream coinstats index computes this block's
+    // "unclaimed reward" as fees minus coinbase outputs and asserts that it fits
+    // an int64. Under PER a payout block can make that value negative, which
+    // aborts the node (and it aborts again on every restart that reaches the
+    // height). Refuse the option until the index learns the reservoir.
+    if (args.GetBoolArg("-coinstatsindex", false)) {
+        return InitError(Untranslated("CacheCoin does not support -coinstatsindex yet: its supply accounting does not know the PER reservoir."));
+    }
+
     // If -forcednsseed is set to true, ensure -dnsseed has not been set to false
     if (args.GetBoolArg("-forcednsseed", DEFAULT_FORCEDNSSEED) && !args.GetBoolArg("-dnsseed", DEFAULT_DNSSEED)){
         return InitError(_("Cannot set -forcednsseed to true when setting -dnsseed to false."));
diff --git a/src/net_processing.cpp b/src/net_processing.cpp
index a376c97..4818a0f 100644
--- a/src/net_processing.cpp
+++ b/src/net_processing.cpp
@@ -2293,7 +2293,9 @@ void PeerManagerImpl::InitiateTxBroadcastPrivate(const CTransactionRef& tx)
 void PeerManagerImpl::RelayPerTicket(const PerTicket& ticket)
 {
     m_connman.ForEachNode([this, &ticket](CNode* pnode) {
-        if (pnode->fSuccessfullyConnected) {
+        // Same rule as transaction relay: block-relay-only links exist to hide
+        // that we are the origin, so a ticket must not cross them.
+        if (pnode->fSuccessfullyConnected && !pnode->IsBlockOnlyConn() && pnode->m_relays_txs) {
             MakeAndPushMessage(*pnode, NetMsgType::PERTICKET, ticket);
         }
     });
@@ -3016,6 +3018,40 @@ void PeerManagerImpl::ProcessHeadersMessage(CNode& pfrom, Peer& peer,
         return;
     }
 
+    // CacheCoin: the cheap checks run before any RandomX hashing. Hashing 2000
+    // unknown headers costs tens of seconds of message-handler time, so a peer
+    // must not be able to force it with headers that are then discarded:
+    //  - a batch that connects to nothing and is not part of a low-work sync in
+    //    progress is a possible BIP130 announcement, handled without hashing;
+    //  - a connecting batch whose claimed work is below the anti-DoS threshold
+    //    and that is not full can never start a sync, so it is ignored.
+    // Everything else is hashed below; a low-work sync continuation must be.
+    if (!CheckHeadersAreContinuous(headers)) {
+        Misbehaving(peer, "non-continuous headers sequence");
+        return;
+    }
+    {
+        const CBlockIndex* chain_start{WITH_LOCK(cs_main, return m_chainman.m_blockman.LookupBlockIndex(headers[0].hashPrevBlock))};
+        bool in_presync{false};
+        {
+            LOCK(peer.m_headers_sync_mutex);
+            in_presync = peer.m_headers_sync != nullptr;
+        }
+        if (chain_start == nullptr && !in_presync) {
+            HandleUnconnectingHeaders(pfrom, peer, headers);
+            return;
+        }
+        if (chain_start != nullptr && !in_presync) {
+            const arith_uint256 total_work{chain_start->nChainWork + CalculateClaimedHeadersWork(headers)};
+            if (total_work < GetAntiDoSWorkThreshold() && headers.size() != m_opts.max_headers_result) {
+                LogDebug(BCLog::NET, "Ignoring low-work chain (height=%u) from peer=%d\n",
+                         chain_start->nHeight + headers.size(), pfrom.GetId());
+                peer.m_last_getheaders_timestamp = {};
+                return;
+            }
+        }
+    }
+
     // Before we do any processing, make sure these pass basic sanity checks.
     // We'll rely on headers having valid proof-of-work further down, as an
     // anti-DoS criteria (note: this check is required before passing any
@@ -4987,6 +5023,10 @@ void PeerManagerImpl::ProcessMessage(Peer& peer, CNode& pfrom, const std::string
             Misbehaving(peer, "oversized perticket");
             return;
         }
+        // A ticket over a block-relay-only link would leak that link's existence;
+        // drop it silently. Do not filter on the peer's relay flag: -blocksonly
+        // ticket miners are honest and must still be able to send tickets.
+        if (pfrom.IsBlockOnlyConn()) return;
         PerTicket ticket;
         vRecv >> ticket;
         // Lock-free sanity first: payout must be a spendable small script.
@@ -5023,7 +5063,10 @@ void PeerManagerImpl::ProcessMessage(Peer& peer, CNode& pfrom, const std::string
             }
             peer.m_per_ticket_last = now;
             if (peer.m_per_ticket_tokens < 1.0) {
-                Misbehaving(peer, "perticket flood");
+                // Drop silently. An honest burst (or Tor bunching) can exceed the
+                // bucket, and disconnecting the relaying peer punishes the relay,
+                // not the flooder; the ticket is only lost for this peer.
+                LogDebug(BCLog::NET, "perticket rate limit, dropping (peer=%d)\n", peer.m_id);
                 return;
             }
             peer.m_per_ticket_tokens -= 1.0;
