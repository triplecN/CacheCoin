             };
             if (!request.params[2].isNull()) {
@@ -337,6 +342,7 @@ static RPCHelpMan shunkobroadcast()
             std::string first_error;
             size_t next{0};
             std::vector<CService> used;
+            bool any_written{false};
             for (int round = 0; round < 2 && delivered < peers && next < candidates.size(); ++round) {
                 std::vector<std::future<std::vector<ShunkoDelivery>>> jobs;
                 for (int i = delivered; i < peers && next < candidates.size(); ++i) {
@@ -357,6 +363,7 @@ static RPCHelpMan shunkobroadcast()
                             if (first_error.empty()) first_error = r.error;
                         }
                         attempts.push_back(a);
+                        if (r.tx_written) any_written = true;
                         if (r.delivered) ++delivered;
                     }
                 }
@@ -369,6 +376,13 @@ static RPCHelpMan shunkobroadcast()
                 }
             }
             if (delivered == 0) {
+                if (any_written) {
+                    // The tx bytes reached a socket before the attempt failed, so the
+                    // node may have processed it. Telling the user "not sent" would
+                    // invite a second payment for the same debt.
+                    throw JSONRPCError(RPC_CLIENT_NODE_NOT_CONNECTED,
+                        "No node confirmed the hand-over, but the transaction was already written to at least one node and may have been delivered. Do not rebuild the payment: retry the same raw transaction with shunkobroadcast, or check the targets' mempools. (" + first_error + ")");
+                }
                 throw JSONRPCError(RPC_CLIENT_NODE_NOT_CONNECTED, "No node could be reached; the transaction was not sent (" + first_error + ")");
             }
             UniValue ret(UniValue::VOBJ);
