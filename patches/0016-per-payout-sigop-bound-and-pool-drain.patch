     p.push_back(static_cast<unsigned char>(std::min<size_t>(ua.size(), 252)));
     p.insert(p.end(), ua.begin(), ua.begin() + std::min<size_t>(ua.size(), 252));
     PutLE<int32_t>(p, start_height);
