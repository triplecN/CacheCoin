     const PerState per_expected{PerNextState(*prev_per, pindex->nHeight, nFees, per->block_tickets, params.GetConsensus())};
@@ -2683,6 +2682,10 @@ bool Chainstate::ConnectBlock(const CBlock& block, BlockValidationState& state,
         return true;
