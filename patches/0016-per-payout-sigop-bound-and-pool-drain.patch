+ *  (wrong state, overpaying coinbase) cannot drain the pool. */
+void PerPoolDropEmbedded(const CBlock& block, const PerCommitment& per,
+                         const CBlockIndex* pindex,
+                         const node::BlockManager& blockman);
 
 #endif // BITCOIN_PER_H
diff --git a/src/rpc/mempool.cpp b/src/rpc/mempool.cpp
index 73c4be2..7a9ae37 100644
--- a/src/rpc/mempool.cpp
+++ b/src/rpc/mempool.cpp
@@ -245,7 +245,14 @@ static RPCHelpMan shunkobroadcast()
                 for (const CNodeStats& s : stats) connected.push_back(s.addr);
             }
             const auto is_connected = [&](const CService& s) {
-                return std::find(connected.begin(), connected.end(), s) != connected.end();
+                // Compare the network address, not IP:port. An inbound peer's
+                // CNodeStats.addr carries its ephemeral source port, so exact
+                // CService equality would miss that peer's listening address in
+                // addrman and hand the transaction to a connected peer anyway.
+                const CNetAddr& net{static_cast<const CNetAddr&>(s)};
+                return std::any_of(connected.begin(), connected.end(), [&](const CService& c) {
+                    return static_cast<const CNetAddr&>(c) == net;
+                });
             };
             const auto add = [&](const CService& s) {
                 if (s.IsValid() && std::find(candidates.begin(), candidates.end(), s) == candidates.end()) candidates.push_back(s);
diff --git a/src/shunko.cpp b/src/shunko.cpp
index 29e4672..bccd7aa 100644
--- a/src/shunko.cpp
+++ b/src/shunko.cpp
@@ -104,7 +104,10 @@ std::vector<unsigned char> VersionPayload(int start_height)
     PutLE<int64_t>(p, 0);                   // time
     for (int i = 0; i < 2; ++i) p.insert(p.end(), 26, 0); // addr_recv, addr_from (services, IPv6, port)
     PutLE<uint64_t>(p, FastRandomContext().rand64()); // nonce
-    const std::string& ua{strSubVersion};
+    // A fixed user agent. strSubVersion carries any -uacomment, which would let a
+    // receiver cluster every hand-over from this node; the one-shot version
